{
  "name": "@hakopod/dashboard",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "packageManager": "pnpm@10.7.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite dev --host 127.0.0.1 --port 3000",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "start": "node --max-old-space-size=192 --env-file-if-exists=.env.local ./node_modules/srvx/bin/srvx.mjs --prod -s ../client dist/server/server.js",
    "generate:api": "openapi-typescript ../api/openapi.json -o src/lib/api.generated.ts",
    "test": "node --experimental-strip-types --test src/server/session.test.ts && node scripts/test-ui.mjs",
    "smoke": "node scripts/smoke-proxy.mjs",
    "format": "prettier --write src scripts vite.config.ts package.json tsconfig.json components.json",
    "format:check": "prettier --check src scripts vite.config.ts package.json tsconfig.json components.json"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-tabs": "1.1.21",
    "@tanstack/react-query": "5.102.8",
    "@tanstack/react-router": "1.170.35",
    "@tanstack/react-start": "1.168.52",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "openapi-fetch": "0.17.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "srvx": "1.0.4",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.0"
  }
}
