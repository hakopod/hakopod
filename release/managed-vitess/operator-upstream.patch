+func firstLiveBackupReady(vts *planetscalev2.VitessShard) bool {
+	if vts.Status.HasMaster != corev1.ConditionTrue || vts.Status.ServingWrites != corev1.ConditionTrue || vts.Status.MasterAlias == "" {
+		return false
+	}
+	primary, ok := vts.Status.Tablets[vts.Status.MasterAlias]
+	return ok && primary.Type == "primary" && primary.Running == corev1.ConditionTrue &&
+		primary.Ready == corev1.ConditionTrue && primary.Available == corev1.ConditionTrue &&
+		primary.DataVolumeBound == corev1.ConditionTrue
