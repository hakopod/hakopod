+	before := defaulted.DeepCopy()
+	if err = validateHakopodFreeResource(defaulted); err != nil {
+		t.Fatal("unused legacy secret default rejected", err)
+	}
+	if !reflect.DeepEqual(defaulted, before) {
+		t.Fatal("validation changed the resource")
+	}
+	for name, change := range map[string]func(*dbapi.SingleInstanceDatabase){
+		"legacy secret name":   func(m *dbapi.SingleInstanceDatabase) { m.Spec.AdminPassword.SecretName = "another-secret" },
+		"legacy secret key":    func(m *dbapi.SingleInstanceDatabase) { m.Spec.AdminPassword.SecretKey = "admin" },
+		"legacy secret keep":   func(m *dbapi.SingleInstanceDatabase) { no := false; m.Spec.AdminPassword.KeepSecret = &no },
+		"legacy secret mount":  func(m *dbapi.SingleInstanceDatabase) { m.Spec.AdminPassword.MountPath = "/another-path" },
+		"legacy wallet bypass": func(m *dbapi.SingleInstanceDatabase) { m.Spec.AdminPassword.SkipInitWallet = true },
+		"restore":              func(m *dbapi.SingleInstanceDatabase) { m.Spec.Restore = &dbapi.SingleInstanceDatabaseRestoreSpec{} },
+		"custom scripts":       func(m *dbapi.SingleInstanceDatabase) { m.Spec.Scripts = &dbapi.SingleInstanceDatabaseScriptsSpec{} },
+		"truecache":            func(m *dbapi.SingleInstanceDatabase) { m.Spec.TrueCache = &dbapi.SingleInstanceDatabaseTrueCacheSpec{} },
+		"archive logging":      func(m *dbapi.SingleInstanceDatabase) { yes := true; m.Spec.ArchiveLog = &yes },
+		"external endpoint":    func(m *dbapi.SingleInstanceDatabase) { m.Spec.Services.Endpoints[0].Type = "LoadBalancer" },
+		"foreign admin":        func(m *dbapi.SingleInstanceDatabase) { m.Spec.Security.Secrets.Admin.SecretName = "foreign" },
