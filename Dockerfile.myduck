# syntax=docker/dockerfile:1.7
FROM python:3.12-slim-trixie@sha256:2b4f19dae3a777dfc3b76730bda1e82e1f66ab2a2686fa93ca78edbfb4f04ffe

RUN apt-get update \
 && apt-get install -y --no-install-recommends bash ca-certificates coreutils libstdc++6 python3 python3-pip tar \
 && printf '%s\n' \
      'sqlglot==30.17.0 --hash=sha256:84435ac283a60173da31b5fd7d11a725037a1c3fd6ed1e21fb065de74ddb579f' \
      'sqlglotc==30.17.0 --hash=sha256:24c0df324d3b8cb1ab65b4139b52dc4de2291ba0e3ce4086ef7fcd0b96555ba3' \
      'sqlglotrs==0.13.0 --hash=sha256:6b934a244b16f26fca50974328a2ebc7689583c59f06203cebb46e2e6e8d93a7' \
      > /tmp/sqlglot-requirements.txt \
 && python3 -m pip install --break-system-packages --no-cache-dir --require-hashes -r /tmp/sqlglot-requirements.txt \
 && rm -f /tmp/sqlglot-requirements.txt \
 && rm -rf /var/lib/apt/lists/* /root/.cache
COPY --chmod=0555 myduckserver /usr/local/bin/myduckserver
COPY --chmod=0555 hakopod-myduck-storage /usr/local/bin/hakopod-myduck-storage
COPY --chmod=0444 licenses/ /usr/share/licenses/myduck/
RUN groupadd --gid 1000 myduck && useradd --uid 1000 --gid 1000 --no-create-home --home-dir /var/lib/myduck --shell /usr/sbin/nologin myduck \
 && install -d -o 1000 -g 1000 -m 0700 /var/lib/myduck
USER 1000:1000
EXPOSE 3306 5432
ENTRYPOINT ["/usr/local/bin/myduckserver"]
CMD []
