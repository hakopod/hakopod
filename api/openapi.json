  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message"
            ]
          }
        },
        "required": [
          "error"
        ]
      },
      "Network": {
        "type": "object",
        "properties": {
          "internal": {
            "type": "boolean"
          }
        },
        "required": []
      },
      "SecretRef": {
        "type": "object",
        "properties": {
          "ref": {
            "type": "string"
          }
        },
        "required": [
          "ref"
        ]
      },
      "Autoscaling": {
        "type": "object",
        "properties": {
          "min_replicas": {
            "type": "integer"
          },
          "max_replicas": {
            "type": "integer"
          },
          "target_cpu": {
            "type": "integer"
          }
        },
        "required": []
      },
      "Service": {
        "type": "object",
        "properties": {
          "image": {
            "type": "string"
          },
          "port": {
            "type": "integer"
          },
          "public": {
            "type": "boolean"
          },
          "size": {
            "type": "string"
          },
          "replicas": {
            "type": "integer"
          },
          "healthcheck": {
            "type": "string"
          },
          "env": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "command": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "args": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "networks": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "secrets": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/components/schemas/SecretRef"
            }
          },
          "autoscaling": {
            "$ref": "#/components/schemas/Autoscaling"
          }
        },
        "required": [
          "image"
        ]
      },
      "Spec": {
        "type": "object",
        "properties": {
          "schema_version": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "services": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/components/schemas/Service"
            }
          },
          "networks": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/components/schemas/Network"
            }
          }
        },
        "required": [
          "schema_version",
          "name",
          "services"
        ]
      },
      "Event": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "time": {
            "type": "string",
            "format": "date-time"
          },
          "type": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "service": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "time",
          "type",
          "message",
          "service"
        ]
      },
      "ServiceStatus": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "ready": {
            "type": "integer"
          },
          "desired": {
            "type": "integer"
          },
          "image": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "internal_address": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "status",
          "ready",
          "desired"
        ]
      },
      "Observation": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "observed_at": {
            "type": "string",
            "format": "date-time"
          },
          "services": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ServiceStatus"
            }
          }
        },
        "required": []
      },
      "Deployment": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "application_id": {
            "type": "string"
          },
          "identity_id": {
            "type": "string"
          },
          "revision": {
            "type": "integer"
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "running",
              "succeeded",
              "failed",
              "cancelled",
              "superseded"
            ]
          },
          "spec": {
            "$ref": "#/components/schemas/Spec"
          },
          "resolved_spec": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Spec"
              },
              {
                "type": "null"
              }
            ]
          },
          "result": {
            "$ref": "#/components/schemas/Observation"
          },
          "error": {
            "type": "string"
          },
          "cancel_requested": {
            "type": "boolean"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "started_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
