@@ -475,6 +501,15 @@ fn decode_heapam_record(
             }
         }
 
+        // PostgreSQL 17.11 WAL includes modified VM pages as block references.
+        // Those pages are ingested in the regular block batch below. Emitting the
+        // legacy synthetic clear as well can apply a second same-LSN operation and,
+        // in the FPI case, race the authoritative page image. Keep the synthetic
+        // record only for legacy WAL that has no registered VM block.
+        if pg_version == PgMajorVersion::PG17 && Self::has_registered_vm_block(decoded) {
+            return Ok(None);
+        }
+
         if new_heap_blkno.is_some() || old_heap_blkno.is_some() {
             let vm_rel = RelTag {
                 forknum: VISIBILITYMAP_FORKNUM,
@@ -537,7 +572,7 @@ fn decode_neonmgr_record(
