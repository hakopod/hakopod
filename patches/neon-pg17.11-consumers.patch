-                            old_heap_blkno = Some(decoded.blocks.last().unwrap().blkno);
+                            old_heap_blkno = Some(Self::old_update_heap_block(decoded)?.blkno);
                         }
                         if (xlrec.flags & pg_constants::XLH_UPDATE_NEW_ALL_VISIBLE_CLEARED) != 0 {
                             // PostgreSQL only uses XLH_UPDATE_NEW_ALL_VISIBLE_CLEARED on a
@@ -579,6 +614,15 @@ fn decode_neonmgr_record(
             ),
         }
 
+        // PostgreSQL 17.11 WAL includes modified VM pages as block references.
+        // Those pages are ingested in the regular block batch below. Emitting the
