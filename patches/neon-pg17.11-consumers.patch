--- a/libs/wal_decoder/src/decoder.rs
+++ b/libs/wal_decoder/src/decoder.rs
@@ -69,6 +69,32 @@ pub fn from_bytes_filtered(
 }
 
 impl MetadataRecord {
+    fn heap_block_by_id(decoded: &DecodedWALRecord, id: u8) -> anyhow::Result<&DecodedBkpBlock> {
+        decoded
+            .blocks
+            .iter()
+            .find(|block| block.id == id)
+            .ok_or_else(|| anyhow::anyhow!("WAL record is missing heap block reference {id}"))
+    }
+
+    fn has_registered_vm_block(decoded: &DecodedWALRecord) -> bool {
+        decoded
+            .blocks
+            .iter()
+            .any(|block| block.forknum == VISIBILITYMAP_FORKNUM)
+    }
+
+    fn old_update_heap_block(decoded: &DecodedWALRecord) -> anyhow::Result<&DecodedBkpBlock> {
+        // Update block 0 is always the new heap page. Block 1 is the old heap
+        // page only when the update crosses pages. PG17.11 can append sparse VM
+        // references 2 and 3, so vector position and last() are not block IDs.
+        Ok(decoded
+            .blocks
+            .iter()
+            .find(|block| block.id == 1)
+            .unwrap_or(Self::heap_block_by_id(decoded, 0)?))
+    }
+
     /// Populates the given `shard_records` with metadata records from this WAL record, if any,
     /// discarding those belonging to other shards.
     ///
@@ -429,7 +455,7 @@ fn decode_heapam_record(
                         // we can't validate the remaining number of bytes without parsing
