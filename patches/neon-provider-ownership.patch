+    if !state.service.get_config().hakopod_ownership_v1 {
+        return Err(ApiError::NotFound(
+            anyhow::anyhow!("Hakopod ownership protocol is disabled").into(),
+        ));
+    }
+    json_response(
+        StatusCode::OK,
+        serde_json::json!({
+            "protocol": "hakopod-ownership-v1",
+            "tenant_delete_protocol": "prepare-v1",
+            "mutations": [
+                "tenant",
+                "timeline",
+                "pageserver_registration",
+                "safekeeper_registration"
+            ]
+        }),
+    )
+}
