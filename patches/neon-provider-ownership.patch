+/// Permanent ownership deletion marker. This deliberately lives outside the
+/// timeline prefix because timeline deletion sweeps every object in that
+/// prefix before removing the index.
+pub fn remote_timeline_ownership_tombstone_path(
+    tenant_shard_id: &TenantShardId,
+    timeline_id: &TimelineId,
+) -> RemotePath {
+    RemotePath::from_string("hakopod-ownership-v1/timeline-tombstones")
+        .expect("static ownership tombstone prefix is valid")
+        .join(Utf8Path::new(&tenant_shard_id.tenant_id.to_string()))
+        .join(Utf8Path::new(&format!("{timeline_id}.tombstone.json")))
+}
+
+/// Immutable ownership reservation for a timeline. This deliberately lives
+/// outside the timeline's data prefix, so checking or deleting timeline data
+/// cannot hide or remove the fence that authorizes strict-mode writers.
+pub fn remote_timeline_ownership_reservation_path(
+    tenant_shard_id: &TenantShardId,
+    timeline_id: &TimelineId,
+) -> RemotePath {
+    RemotePath::from_string("hakopod-ownership-v1/timeline-reservations")
+        .expect("static ownership reservation prefix is valid")
+        .join(Utf8Path::new(&tenant_shard_id.tenant_id.to_string()))
+        .join(Utf8Path::new(&format!("{timeline_id}.reservation.json")))
