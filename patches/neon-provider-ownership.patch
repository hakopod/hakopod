+    Active,
+    Terminated,
+}
+
+#[derive(Clone, Debug, Deserialize, Eq, PartialEq, Serialize)]
+struct OwnershipRecord {
+    schema_version: u8,
+    token: String,
+    spec_sha256: String,
+    state: OwnershipState,
+}
+
+#[derive(Debug, thiserror::Error)]
+pub enum OwnershipError {
+    #[error("compute ownership conflict")]
+    Conflict,
+    #[error("compute ownership persistence failed: {0}")]
+    Persistence(#[source] anyhow::Error),
+}
+
+pub struct ComputeOwnership {
+    path: Option<PathBuf>,
+    lock_path: Option<PathBuf>,
+    record: Mutex<Option<OwnershipRecord>>,
+    // Keep exclusive authority for the entire compute_ctl lifetime. A lock
+    // taken only around authorization leaves the following process mutation
+    // exposed to a second compute_ctl using the same durable record.
+    _lifetime_lock: Option<Flock<File>>,
+}
+
+impl ComputeOwnership {
+    pub fn load(path: Option<OsString>) -> Result<Self> {
+        let Some(path) = path.map(PathBuf::from) else {
+            return Ok(Self {
+                path: None,
+                lock_path: None,
+                record: Mutex::new(None),
+                _lifetime_lock: None,
+            });
+        };
+        if !path.is_absolute() || path.file_name().is_none() {
+            bail!("compute ownership state path must be an absolute file path");
+        }
+        let parent = path
+            .parent()
+            .ok_or_else(|| anyhow!("compute ownership state has no parent"))?;
+        validate_private_parent(parent)?;
+        let lock_path = parent
+            .join(lock_file_name(path.file_name().ok_or_else(|| {
+                anyhow!("compute ownership state has no file name")
+            })?));
+        let mut ownership = Self {
+            path: Some(path),
+            lock_path: Some(lock_path),
+            record: Mutex::new(None),
+            _lifetime_lock: None,
+        };
+        let lifetime_lock = ownership.acquire_file_lock()?;
+        ownership.record = Mutex::new(ownership.read_record()?);
+        ownership._lifetime_lock = Some(lifetime_lock);
+        Ok(ownership)
+    }
+
+    pub fn enabled(&self) -> bool {
+        self.path.is_some()
+    }
+
+    pub fn token(&self) -> std::result::Result<Option<String>, OwnershipError> {
+        if !self.enabled() {
+            return Ok(None);
+        }
+        let mut guard = self.lock_record().map_err(OwnershipError::Persistence)?;
+        let record = self.read_record().map_err(OwnershipError::Persistence)?;
+        *guard = record.clone();
+        Ok(record.map(|record| record.token))
+    }
+
+    pub fn authorize_configure(
+        &self,
+        headers: &HeaderMap,
+        spec: &ComputeSpec,
+    ) -> std::result::Result<(), OwnershipError> {
+        if !self.enabled() {
+            return Ok(());
+        }
+        let token = required_token(headers)?;
+        if spec.operation_uuid.as_deref() != Some(token) {
+            return Err(OwnershipError::Conflict);
+        }
+        let hash = spec_hash(spec).map_err(OwnershipError::Persistence)?;
+        let mut guard = self.lock_record().map_err(OwnershipError::Persistence)?;
+        let record = self.read_record().map_err(OwnershipError::Persistence)?;
+        *guard = record.clone();
+        match record {
+            Some(record)
+                if record.state == OwnershipState::Active
+                    && record.token == token
+                    && record.spec_sha256 == hash =>
+            {
+                Ok(())
+            }
+            Some(_) => Err(OwnershipError::Conflict),
+            None => {
+                let record = OwnershipRecord {
+                    schema_version: OWNERSHIP_SCHEMA_VERSION,
+                    token: token.to_owned(),
+                    spec_sha256: hash,
+                    state: OwnershipState::Active,
+                };
+                self.persist_new(&record)
+                    .map_err(OwnershipError::Persistence)?;
+                *guard = Some(record);
+                Ok(())
+            }
+        }
+    }
+
+    pub fn authorize_spec_replay(
+        &self,
+        headers: &HeaderMap,
+        spec: &ComputeSpec,
+    ) -> std::result::Result<(), OwnershipError> {
+        if !self.enabled() {
+            return Ok(());
+        }
+        let token = required_token(headers)?;
+        if spec.operation_uuid.as_deref() != Some(token) {
+            return Err(OwnershipError::Conflict);
+        }
+        let hash = spec_hash(spec).map_err(OwnershipError::Persistence)?;
+        let mut guard = self.lock_record().map_err(OwnershipError::Persistence)?;
+        let record = self.read_record().map_err(OwnershipError::Persistence)?;
+        *guard = record.clone();
+        match record {
+            Some(record)
+                if record.state == OwnershipState::Active
+                    && record.token == token
+                    && record.spec_sha256 == hash =>
+            {
+                Ok(())
+            }
+            _ => Err(OwnershipError::Conflict),
+        }
+    }
+
+    pub fn authorize_terminate(
+        &self,
+        headers: &HeaderMap,
+    ) -> std::result::Result<(), OwnershipError> {
+        if !self.enabled() {
+            return Ok(());
+        }
+        let token = required_token(headers)?;
+        let mut guard = self.lock_record().map_err(OwnershipError::Persistence)?;
+        let record = self.read_record().map_err(OwnershipError::Persistence)?;
+        *guard = record.clone();
+        let Some(record) = record else {
+            return Err(OwnershipError::Conflict);
+        };
+        if record.token != token {
+            return Err(OwnershipError::Conflict);
+        }
+        if record.state == OwnershipState::Active {
+            let mut tombstone = record;
+            tombstone.state = OwnershipState::Terminated;
+            self.persist_replacement(&tombstone)
+                .map_err(OwnershipError::Persistence)?;
+            *guard = Some(tombstone);
+        }
+        Ok(())
+    }
+
+    fn lock_record(&self) -> Result<MutexGuard<'_, Option<OwnershipRecord>>> {
+        self.record
+            .lock()
+            .map_err(|_| anyhow!("compute ownership process lock is poisoned"))
+    }
+
+    fn acquire_file_lock(&self) -> Result<Flock<File>> {
+        let lock_path = self
+            .lock_path
+            .as_ref()
+            .ok_or_else(|| anyhow!("compute ownership lock path is unavailable"))?;
+        let parent = lock_path
+            .parent()
+            .ok_or_else(|| anyhow!("compute ownership lock has no parent"))?;
+        validate_private_parent(parent)?;
+        let deadline = Instant::now() + OWNERSHIP_LOCK_TIMEOUT;
+        loop {
+            let mut options = OpenOptions::new();
+            options.read(true).write(true).create(true);
+            #[cfg(unix)]
+            {
+                options
+                    .mode(0o600)
+                    .custom_flags((OFlag::O_NOFOLLOW | OFlag::O_NONBLOCK).bits());
+            }
+            let file = options
+                .open(lock_path)
+                .context("open compute ownership lock")?;
+            let metadata = file
+                .metadata()
+                .context("read compute ownership lock metadata")?;
+            validate_private_regular_file(&metadata, "compute ownership lock")?;
+            match Flock::lock(file, FlockArg::LockExclusiveNonblock) {
+                Ok(file_lock) => {
+                    let path_metadata = fs::symlink_metadata(lock_path)
+                        .context("inspect compute ownership lock path")?;
+                    validate_private_regular_file(&path_metadata, "compute ownership lock path")?;
+                    if same_file(&metadata, &path_metadata) {
+                        return Ok(file_lock);
+                    }
+                }
+                Err((_, error)) if error == Errno::EAGAIN => {}
+                Err((_, error)) => return Err(error).context("lock compute ownership state"),
+            }
+            if Instant::now() >= deadline {
+                bail!("timed out locking compute ownership state");
+            }
+            thread::sleep(OWNERSHIP_LOCK_RETRY);
+        }
+    }
+
+    fn read_record(&self) -> Result<Option<OwnershipRecord>> {
+        let path = self
+            .path
+            .as_ref()
+            .ok_or_else(|| anyhow!("compute ownership state path is unavailable"))?;
+        let initial_metadata = match fs::symlink_metadata(path) {
+            Ok(metadata) => metadata,
+            Err(error) if error.kind() == ErrorKind::NotFound => return Ok(None),
+            Err(error) => return Err(error).context("inspect compute ownership state path"),
+        };
+        validate_private_regular_file(&initial_metadata, "compute ownership state path")?;
+        let mut options = OpenOptions::new();
+        options.read(true);
+        #[cfg(unix)]
+        {
+            options.custom_flags((OFlag::O_NOFOLLOW | OFlag::O_NONBLOCK).bits());
+        }
+        let file = options.open(path).context("open compute ownership state")?;
+        let metadata = file.metadata().context("read compute ownership metadata")?;
+        validate_private_regular_file(&metadata, "compute ownership state")?;
+        if metadata.len() > MAX_OWNERSHIP_RECORD_BYTES {
+            bail!("compute ownership state exceeds its size bound");
+        }
+        let path_metadata =
+            fs::symlink_metadata(path).context("inspect compute ownership state path")?;
+        validate_private_regular_file(&path_metadata, "compute ownership state path")?;
+        if !same_file(&metadata, &path_metadata) {
+            bail!("compute ownership state changed while opening");
+        }
+        let record: OwnershipRecord =
+            serde_json::from_reader(file.take(MAX_OWNERSHIP_RECORD_BYTES + 1))
+                .context("decode compute ownership state")?;
+        validate_record(&record)?;
+        Ok(Some(record))
+    }
+
+    fn persist_new(&self, record: &OwnershipRecord) -> Result<()> {
+        let (path, parent, temp_path, file) = self.write_temp_record(record)?;
+        file.sync_all().context("sync compute ownership state")?;
+        match fs::hard_link(&temp_path, path) {
+            Ok(()) => {}
+            Err(error) if error.kind() == ErrorKind::AlreadyExists => {
+                let _ = fs::remove_file(&temp_path);
+                bail!("compute ownership state was concurrently created");
+            }
+            Err(error) => {
+                let _ = fs::remove_file(&temp_path);
+                return Err(error).context("publish new compute ownership state");
+            }
+        }
+        let publish_result = sync_directory(parent)
+            .and_then(|()| {
+                fs::remove_file(&temp_path).context("remove compute ownership state temporary file")
+            })
+            .and_then(|()| sync_directory(parent));
+        if publish_result.is_err() {
+            let _ = fs::remove_file(&temp_path);
+        }
+        publish_result
+    }
+
+    fn persist_replacement(&self, record: &OwnershipRecord) -> Result<()> {
+        let (path, parent, temp_path, file) = self.write_temp_record(record)?;
+        file.sync_all().context("sync compute ownership state")?;
+        let publish_result = fs::rename(&temp_path, path)
+            .context("publish replacement compute ownership state")
+            .and_then(|()| sync_directory(parent));
+        if publish_result.is_err() {
+            let _ = fs::remove_file(&temp_path);
+        }
+        publish_result
+    }
+
+    fn write_temp_record(&self, record: &OwnershipRecord) -> Result<(&Path, &Path, PathBuf, File)> {
+        let path = self
+            .path
+            .as_deref()
+            .ok_or_else(|| anyhow!("compute ownership state path is unavailable"))?;
+        let parent = path
+            .parent()
+            .ok_or_else(|| anyhow!("compute ownership state has no parent"))?;
+        validate_private_parent(parent)?;
+        let bytes = serde_json::to_vec(record).context("encode compute ownership state")?;
+        if bytes.len() as u64 > MAX_OWNERSHIP_RECORD_BYTES {
+            bail!("compute ownership state exceeds its size bound");
+        }
+        let temp_path = parent
+            .join(temp_file_name(path.file_name().ok_or_else(|| {
+                anyhow!("compute ownership state has no file name")
+            })?));
+        let mut options = OpenOptions::new();
+        options.write(true).create_new(true);
+        #[cfg(unix)]
+        {
+            options.mode(0o600).custom_flags(OFlag::O_NOFOLLOW.bits());
+        }
+        let mut file = options
+            .open(&temp_path)
+            .context("create compute ownership state temporary file")?;
+        let metadata = file
+            .metadata()
+            .context("read compute ownership temporary file metadata")?;
+        validate_private_regular_file(&metadata, "compute ownership temporary file")?;
+        if let Err(error) = file
+            .write_all(&bytes)
+            .context("write compute ownership state")
+        {
+            let _ = fs::remove_file(&temp_path);
+            return Err(error);
+        }
+        Ok((path, parent, temp_path, file))
+    }
+}
+
+fn required_token(headers: &HeaderMap) -> std::result::Result<&str, OwnershipError> {
+    let token = headers
+        .get(HAKOPOD_OWNERSHIP_TOKEN_HEADER)
+        .and_then(|value| value.to_str().ok())
+        .ok_or(OwnershipError::Conflict)?;
+    let parsed = Uuid::parse_str(token).map_err(|_| OwnershipError::Conflict)?;
+    if parsed.is_nil() || parsed.simple().to_string() != token {
+        return Err(OwnershipError::Conflict);
+    }
+    Ok(token)
+}
+
+fn validate_record(record: &OwnershipRecord) -> Result<()> {
+    if record.schema_version != OWNERSHIP_SCHEMA_VERSION {
+        bail!("unsupported compute ownership state version");
+    }
+    let token = Uuid::parse_str(&record.token).context("invalid compute ownership token")?;
+    if token.is_nil() || token.simple().to_string() != record.token {
+        bail!("invalid compute ownership token encoding");
+    }
+    if record.spec_sha256.len() != 64
+        || !record
+            .spec_sha256
+            .bytes()
+            .all(|value| value.is_ascii_digit() || (b'a'..=b'f').contains(&value))
+    {
+        bail!("invalid compute ownership spec hash");
+    }
+    Ok(())
+}
+
+fn validate_private_parent(parent: &Path) -> Result<()> {
+    let metadata = fs::symlink_metadata(parent).context("inspect compute ownership parent")?;
+    if metadata.file_type().is_symlink() || !metadata.is_dir() {
+        bail!("compute ownership parent must be a real directory");
+    }
+    #[cfg(unix)]
+    {
+        if metadata.uid() != effective_uid() {
+            bail!("compute ownership parent must be owned by the compute user");
+        }
+        if metadata.permissions().mode() & 0o077 != 0 {
+            bail!("compute ownership parent must not be accessible by group or other users");
+        }
+    }
+    Ok(())
+}
+
+fn validate_private_regular_file(metadata: &Metadata, description: &str) -> Result<()> {
+    if !metadata.is_file() {
+        bail!("{description} must be a regular file");
+    }
+    #[cfg(unix)]
+    {
+        if metadata.uid() != effective_uid() {
+            bail!("{description} must be owned by the compute user");
+        }
+        if metadata.permissions().mode() & 0o777 != 0o600 {
+            bail!("{description} must have mode 0600");
+        }
+    }
+    Ok(())
+}
+
+#[cfg(unix)]
+fn effective_uid() -> u32 {
+    nix::unistd::geteuid().as_raw()
+}
+
+#[cfg(unix)]
+fn same_file(left: &Metadata, right: &Metadata) -> bool {
+    left.dev() == right.dev() && left.ino() == right.ino()
+}
+
+#[cfg(not(unix))]
+fn same_file(_left: &Metadata, _right: &Metadata) -> bool {
+    true
+}
+
+fn lock_file_name(file_name: &OsStr) -> OsString {
+    let mut name = OsString::from(".");
+    name.push(file_name);
+    name.push(".lock");
+    name
+}
+
+fn temp_file_name(file_name: &OsStr) -> OsString {
+    let mut name = OsString::from(".");
+    name.push(file_name);
+    name.push(".");
+    name.push(Uuid::new_v4().simple().to_string());
+    name.push(".tmp");
+    name
+}
+
+fn sync_directory(parent: &Path) -> Result<()> {
+    File::open(parent)
+        .and_then(|directory| directory.sync_all())
+        .context("sync compute ownership state directory")
+}
+
+fn spec_hash(spec: &ComputeSpec) -> Result<String> {
+    let value = serde_json::to_value(spec).context("serialize owned compute spec")?;
+    let mut canonical = Vec::new();
+    write_canonical_json(&value, &mut canonical)?;
+    Ok(hex::encode(Sha256::digest(canonical)))
+}
+
+fn write_canonical_json(value: &Value, output: &mut Vec<u8>) -> Result<()> {
+    match value {
+        Value::Null => output.extend_from_slice(b"null"),
+        Value::Bool(value) => output.extend_from_slice(if *value { b"true" } else { b"false" }),
+        Value::Number(value) => output.extend_from_slice(value.to_string().as_bytes()),
+        Value::String(value) => serde_json::to_writer(output, value)?,
+        Value::Array(values) => {
+            output.push(b'[');
+            for (index, value) in values.iter().enumerate() {
+                if index > 0 {
+                    output.push(b',');
+                }
+                write_canonical_json(value, output)?;
+            }
+            output.push(b']');
+        }
+        Value::Object(values) => {
+            output.push(b'{');
+            let mut keys: Vec<_> = values.keys().collect();
+            keys.sort_unstable();
+            for (index, key) in keys.into_iter().enumerate() {
+                if index > 0 {
+                    output.push(b',');
+                }
+                serde_json::to_writer(&mut *output, key)?;
+                output.push(b':');
+                write_canonical_json(&values[key], output)?;
+            }
+            output.push(b'}');
+        }
+    }
+    Ok(())
+}
