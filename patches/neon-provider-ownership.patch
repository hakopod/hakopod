+                            let node_id = external_key.parse::<i64>().map_err(|_| {
+                                DatabaseError::Cas("invalid pageserver ownership key".into())
+                            })?;
+                            diesel::sql_query(
+                                "SELECT EXISTS(SELECT 1 FROM nodes WHERE node_id = $1) AS exists",
+                            )
+                            .bind::<diesel::sql_types::BigInt, _>(node_id)
+                            .get_result::<ExistsRow>(conn)
+                            .await?
+                            .exists
+                        }
+                        "safekeeper_registration" => {
+                            let node_id = external_key.parse::<i64>().map_err(|_| {
+                                DatabaseError::Cas("invalid safekeeper ownership key".into())
+                            })?;
+                            diesel::sql_query(
+                                "SELECT EXISTS(SELECT 1 FROM safekeepers WHERE id = $1) AS exists",
+                            )
+                            .bind::<diesel::sql_types::BigInt, _>(node_id)
+                            .get_result::<ExistsRow>(conn)
+                            .await?
+                            .exists
+                        }
