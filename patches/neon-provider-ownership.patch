+        assert!(reserve(&conf, ttid, token, hash, false).await.is_err());
+
+        std::fs::remove_file(record_path(&conf, ttid)).unwrap();
+        let record = TimelineOwnership {
+            schema_version: SCHEMA_VERSION,
+            token: token.to_owned(),
+            request_hash: hash.to_owned(),
+            tombstoned: false,
+        };
+        std::fs::write(
+            record_path(&conf, ttid),
+            serde_json::to_vec(&record).unwrap(),
+        )
+        .unwrap();
+        std::fs::set_permissions(
+            record_path(&conf, ttid),
+            std::fs::Permissions::from_mode(0o644),
+        )
+        .unwrap();
+        assert!(describe(&conf, ttid).await.is_err());
+    }
+
+    #[tokio::test]
+    async fn concurrent_reserve_and_delete_leave_a_permanent_tombstone() {
+        let dir = camino_tempfile::tempdir().unwrap();
+        let mut conf = SafeKeeperConf::dummy();
+        conf.workdir = dir.path().to_owned();
+        let ttid = id("dddddddddddddddddddddddddddddddd");
+        let token = "eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee";
+        let hash = "ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff";
+        reserve(&conf, ttid, token, hash, false).await.unwrap();
+
+        let (replay, deletion) = tokio::join!(
+            reserve(&conf, ttid, token, hash, true),
+            tombstone(&conf, ttid, token),
+        );
+        deletion.unwrap();
+        if replay.is_ok() {
+            assert!(reserve(&conf, ttid, token, hash, true).await.is_err());
+        }
+        let described = describe(&conf, ttid).await.unwrap().unwrap();
+        assert!(described.tombstoned);
+        assert_eq!(described.token, token);
+    }
+}
