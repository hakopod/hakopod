+async fn read_timeline_ownership_object(
+    remote_storage: &GenericRemoteStorage,
+    path: &remote_storage::RemotePath,
+    cancel: &CancellationToken,
+    kind: &'static str,
+) -> anyhow::Result<Option<TimelineOwnershipRecord>> {
+    let download = match remote_storage
+        .download(path, &DownloadOpts::default(), cancel)
+        .await
+    {
+        Ok(download) => download,
+        Err(DownloadError::NotFound) => return Ok(None),
+        Err(error) => return Err(error.into()),
+    };
+    let bytes = download
+        .download_stream
+        .try_fold(Vec::new(), |mut all, chunk| async move {
+            if all.len() + chunk.len() > 4096 {
+                return Err(std::io::Error::other(format!(
+                    "timeline ownership {kind} exceeds limit"
+                )));
+            }
+            all.extend_from_slice(&chunk);
+            Ok(all)
+        })
+        .await?;
+    let record: TimelineOwnershipRecord = serde_json::from_slice(&bytes)?;
+    anyhow::ensure!(
+        record.schema_version == 1,
+        "unsupported timeline ownership {kind}"
+    );
+    Ok(Some(record))
+}
