new file mode 100644
index 0000000000000000000000000000000000000000..e4f10a132e7bd9027f542a64bdfe05f120454b52
--- /dev/null
+++ b/hakopod-ownership/contract.rs
@@ -0,0 +1,46 @@
+//! Reference state machine for the provider-owned idempotency implemented by
+//! the storage controller and its downstream services.
+
+use serde::{Deserialize, Serialize};
+use serde_json::Value;
+use uuid::Uuid;
+
+#[derive(Clone, Debug, Eq, PartialEq, Serialize, Deserialize)]
+#[serde(rename_all = "snake_case")]
+pub enum State { Reserved, Applying, Completed, Failed, Deleting, Tombstoned }
+
+#[derive(Clone, Debug, Serialize, Deserialize)]
+pub struct Record {
+    pub ownership_token: Uuid,
+    pub resource_kind: String,
+    pub external_key: String,
+    pub request_hash: [u8; 32],
+    pub state: State,
+    pub result: Option<Value>,
+    pub error_code: Option<String>,
+}
+
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub enum Decision { Begin, Resume, Replay(Value), Conflict, Gone }
+
+impl Record {
+    pub fn decide(&self, token: Uuid, hash: [u8; 32]) -> Decision {
+        if self.ownership_token != token || self.request_hash != hash { return Decision::Conflict; }
+        match self.state {
+            State::Reserved | State::Applying => Decision::Resume,
+            State::Completed => Decision::Replay(self.result.clone().expect("completed result")),
+            State::Failed => Decision::Conflict,
+            State::Deleting | State::Tombstoned => Decision::Gone,
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    fn record(state: State) -> Record { Record { ownership_token: Uuid::nil(), resource_kind: "tenant".into(), external_key: "tenant-1".into(), request_hash: [7; 32], state, result: Some(Value::String("identity".into())), error_code: None } }
+    #[test] fn exact_replay_returns_stored_identity() { assert!(matches!(record(State::Completed).decide(Uuid::nil(), [7; 32]), Decision::Replay(_))); }
+    #[test] fn foreign_token_is_rejected() { assert_eq!(record(State::Applying).decide(Uuid::from_u128(1), [7; 32]), Decision::Conflict); }
+    #[test] fn changed_parameters_are_rejected() { assert_eq!(record(State::Applying).decide(Uuid::nil(), [8; 32]), Decision::Conflict); }
+    #[test] fn deletion_fences_replay() { assert_eq!(record(State::Tombstoned).decide(Uuid::nil(), [7; 32]), Decision::Gone); }
+}
