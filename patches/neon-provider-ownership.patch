+                    Ok(existing)
+                } else {
+                    Err(DeleteTenantError::OwnershipConflict(
+                        "tenant delete fence conflicts with the authorized resources".to_string(),
+                    ))
+                }
+            }
+            Err(ConditionalCreateError::Other(error)) => Err(DeleteTenantError::Other(error)),
+        }
+    }
