+                                "SELECT EXISTS(SELECT 1 FROM timelines WHERE tenant_id = $1 AND timeline_id = $2) AS exists",
+                            )
+                            .bind::<diesel::sql_types::Text, _>(tenant_id)
+                            .bind::<diesel::sql_types::Text, _>(timeline_id)
+                            .get_result::<ExistsRow>(conn)
+                            .await?
+                            .exists
+                        }
