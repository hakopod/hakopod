+use std::fs::{File, OpenOptions};
+use std::io::{ErrorKind, Read, Write};
+use std::time::{Duration, Instant};
+
+use anyhow::{Context, Result, bail};
+use camino::{Utf8Path, Utf8PathBuf};
+use nix::errno::Errno;
+use nix::fcntl::{Flock, FlockArg, OFlag};
+use serde::{Deserialize, Serialize};
+use tokio::fs;
+use utils::id::TenantTimelineId;
+
+#[cfg(unix)]
+use std::os::unix::fs::{MetadataExt, OpenOptionsExt, PermissionsExt};
+
+use crate::SafeKeeperConf;
+
+const SCHEMA_VERSION: u8 = 1;
+const MAX_RECORD_BYTES: u64 = 4096;
+const LOCK_TIMEOUT: Duration = Duration::from_secs(5);
+const LOCK_RETRY: Duration = Duration::from_millis(10);
+
+#[derive(Clone, Debug, Eq, PartialEq, Serialize, Deserialize)]
+pub struct TimelineOwnership {
+    pub schema_version: u8,
+    pub token: String,
+    pub request_hash: String,
+    pub tombstoned: bool,
+}
+
+fn validate(token: &str, request_hash: &str) -> Result<()> {
+    if token.len() != 32
+        || token == "00000000000000000000000000000000"
+        || !token
+            .bytes()
+            .all(|byte| byte.is_ascii_digit() || (b'a'..=b'f').contains(&byte))
+    {
+        bail!("invalid Hakopod ownership token");
+    }
+    if request_hash.len() != 64
+        || !request_hash
+            .bytes()
+            .all(|byte| byte.is_ascii_digit() || (b'a'..=b'f').contains(&byte))
+    {
+        bail!("invalid Hakopod ownership request hash");
+    }
+    Ok(())
+}
+
+fn directory(conf: &SafeKeeperConf) -> Utf8PathBuf {
+    conf.workdir.join("hakopod-ownership-v1")
+}
+
+fn record_path(conf: &SafeKeeperConf, ttid: TenantTimelineId) -> Utf8PathBuf {
+    directory(conf).join(format!("{}-{}.json", ttid.tenant_id, ttid.timeline_id))
+}
+
+fn tombstone_path(conf: &SafeKeeperConf, ttid: TenantTimelineId) -> Utf8PathBuf {
+    directory(conf).join(format!(
+        "{}-{}.tombstone.json",
+        ttid.tenant_id, ttid.timeline_id
+    ))
+}
+
+fn lock_path(conf: &SafeKeeperConf, ttid: TenantTimelineId) -> Utf8PathBuf {
+    directory(conf).join(format!("{}-{}.lock", ttid.tenant_id, ttid.timeline_id))
+}
+
+async fn ensure_directory(path: &Utf8Path) -> Result<()> {
+    fs::create_dir_all(path)
+        .await
+        .context("create ownership directory")?;
+    let metadata = fs::symlink_metadata(path)
+        .await
+        .context("inspect ownership directory")?;
+    if metadata.file_type().is_symlink() || !metadata.is_dir() {
+        bail!("ownership path must be a real directory");
+    }
+    #[cfg(unix)]
+    {
+        if metadata.uid() != nix::unistd::geteuid().as_raw() {
+            bail!("ownership directory must be owned by the safekeeper user");
+        }
+        fs::set_permissions(path, std::fs::Permissions::from_mode(0o700))
+            .await
+            .context("secure ownership directory")?;
+    }
+    Ok(())
+}
+
+async fn read(path: &Utf8Path) -> Result<Option<TimelineOwnership>> {
+    let initial_metadata = match std::fs::symlink_metadata(path) {
+        Ok(metadata) => metadata,
+        Err(error) if error.kind() == ErrorKind::NotFound => return Ok(None),
+        Err(error) => return Err(error).context("inspect ownership record"),
+    };
+    validate_private_file(&initial_metadata, "ownership record")?;
+    let mut options = OpenOptions::new();
+    options.read(true);
+    #[cfg(unix)]
+    options.custom_flags((OFlag::O_NOFOLLOW | OFlag::O_NONBLOCK).bits());
+    let file = options.open(path).context("open ownership record")?;
+    let metadata = file.metadata().context("inspect opened ownership record")?;
+    validate_private_file(&metadata, "ownership record")?;
+    let path_metadata = std::fs::symlink_metadata(path).context("reinspect ownership record")?;
+    validate_private_file(&path_metadata, "ownership record")?;
+    if !same_file(&metadata, &path_metadata) || !same_file(&initial_metadata, &path_metadata) {
+        bail!("ownership record changed while opening");
+    }
+    let mut bytes = Vec::new();
+    file.take(MAX_RECORD_BYTES + 1)
+        .read_to_end(&mut bytes)
+        .context("read ownership record")?;
+    if bytes.len() as u64 > MAX_RECORD_BYTES {
+        bail!("ownership record exceeds its size bound");
+    }
+    let record: TimelineOwnership =
+        serde_json::from_slice(&bytes).context("decode ownership record")?;
+    if record.schema_version != SCHEMA_VERSION {
+        bail!("unsupported ownership record version");
+    }
+    validate(&record.token, &record.request_hash)?;
+    Ok(Some(record))
+}
+
+async fn create(path: &Utf8Path, record: &TimelineOwnership) -> Result<bool> {
+    let bytes = serde_json::to_vec(record).context("encode ownership record")?;
+    let parent = path.parent().context("ownership record has no parent")?;
+    let temporary = parent.join(format!(
+        ".hakopod-ownership-{:016x}.tmp",
+        rand::random::<u64>()
+    ));
+    let cleanup = scopeguard::guard(temporary.clone(), |path| {
+        let _ = std::fs::remove_file(path);
+    });
+    let mut options = OpenOptions::new();
+    options.write(true).create_new(true);
+    #[cfg(unix)]
+    {
+        options.mode(0o600).custom_flags(OFlag::O_NOFOLLOW.bits());
+    }
+    let mut file = match options.open(&temporary) {
+        Ok(file) => file,
+        Err(error) => return Err(error).context("create temporary ownership record"),
+    };
+    validate_private_file(
+        &file
+            .metadata()
+            .context("inspect temporary ownership record")?,
+        "temporary ownership record",
+    )?;
+    file.write_all(&bytes).context("write ownership record")?;
+    file.sync_all().context("sync ownership record")?;
+    drop(file);
+
+    let published = match std::fs::hard_link(&temporary, path) {
+        Ok(()) => true,
+        Err(error) if error.kind() == ErrorKind::AlreadyExists => false,
+        Err(error) => return Err(error).context("publish ownership record"),
+    };
+    drop(cleanup);
+    if published {
+        std::fs::File::open(parent)
+            .and_then(|directory| directory.sync_all())
+            .context("sync ownership directory")?;
+    }
+    Ok(published)
+}
+
+async fn acquire_resource_lock(
+    conf: &SafeKeeperConf,
+    ttid: TenantTimelineId,
+) -> Result<Flock<File>> {
+    let directory = directory(conf);
+    ensure_directory(&directory).await?;
+    let path = lock_path(conf, ttid);
+    let deadline = Instant::now() + LOCK_TIMEOUT;
+    loop {
+        let mut options = OpenOptions::new();
+        options.read(true).write(true).create(true);
+        #[cfg(unix)]
+        options
+            .mode(0o600)
+            .custom_flags((OFlag::O_NOFOLLOW | OFlag::O_NONBLOCK).bits());
+        let file = options.open(&path).context("open ownership lock")?;
+        let metadata = file.metadata().context("inspect ownership lock")?;
+        validate_private_file(&metadata, "ownership lock")?;
+        match Flock::lock(file, FlockArg::LockExclusiveNonblock) {
+            Ok(lock) => {
+                let path_metadata =
+                    std::fs::symlink_metadata(&path).context("reinspect ownership lock")?;
+                validate_private_file(&path_metadata, "ownership lock")?;
+                if same_file(&metadata, &path_metadata) {
+                    return Ok(lock);
+                }
+            }
+            Err((_, Errno::EAGAIN)) => {}
+            Err((_, error)) => return Err(error).context("lock ownership state"),
+        }
+        if Instant::now() >= deadline {
+            bail!("timed out locking ownership state");
+        }
+        tokio::time::sleep(LOCK_RETRY).await;
+    }
+}
+
+fn validate_private_file(metadata: &std::fs::Metadata, description: &str) -> Result<()> {
+    if !metadata.is_file() || metadata.len() > MAX_RECORD_BYTES {
+        bail!("{description} is unsafe or exceeds its size bound");
+    }
+    #[cfg(unix)]
+    {
+        if metadata.uid() != nix::unistd::geteuid().as_raw() {
+            bail!("{description} must be owned by the safekeeper user");
+        }
+        if metadata.permissions().mode() & 0o777 != 0o600 {
+            bail!("{description} must have mode 0600");
+        }
+    }
+    Ok(())
+}
+
+#[cfg(unix)]
+fn same_file(left: &std::fs::Metadata, right: &std::fs::Metadata) -> bool {
+    left.dev() == right.dev() && left.ino() == right.ino()
+}
+
+#[cfg(not(unix))]
+fn same_file(_left: &std::fs::Metadata, _right: &std::fs::Metadata) -> bool {
+    true
+}
+
+pub async fn reserve(
+    conf: &SafeKeeperConf,
+    ttid: TenantTimelineId,
+    token: &str,
+    request_hash: &str,
+    resource_exists: bool,
+) -> Result<()> {
+    validate(token, request_hash)?;
+    let _lock = acquire_resource_lock(conf, ttid).await?;
+    if read(&tombstone_path(conf, ttid)).await?.is_some() {
+        bail!("timeline ownership is permanently tombstoned");
+    }
+    let wanted = TimelineOwnership {
+        schema_version: SCHEMA_VERSION,
+        token: token.to_owned(),
+        request_hash: request_hash.to_owned(),
+        tombstoned: false,
+    };
+    let path = record_path(conf, ttid);
+    if let Some(stored) = read(&path).await? {
+        if stored != wanted {
+            bail!("timeline ownership token or request hash conflicts");
+        }
+    } else {
+        if resource_exists {
+            bail!("refusing to adopt a pre-existing unowned timeline");
+        }
+        if !create(&path, &wanted).await? && read(&path).await?.as_ref() != Some(&wanted) {
+            bail!("timeline ownership token or request hash conflicts");
+        }
+    }
+    if read(&tombstone_path(conf, ttid)).await?.is_some() {
+        bail!("timeline ownership is permanently tombstoned");
+    }
+    Ok(())
+}
+
+pub async fn describe(
+    conf: &SafeKeeperConf,
+    ttid: TenantTimelineId,
+) -> Result<Option<TimelineOwnership>> {
+    let _lock = acquire_resource_lock(conf, ttid).await?;
+    if let Some(tombstone) = read(&tombstone_path(conf, ttid)).await? {
+        return Ok(Some(tombstone));
+    }
+    read(&record_path(conf, ttid)).await
+}
+
+pub async fn verify(
+    conf: &SafeKeeperConf,
+    ttid: TenantTimelineId,
+    token: &str,
+    request_hash: &str,
+    allow_tombstoned: bool,
+) -> Result<TimelineOwnership> {
+    validate(token, request_hash)?;
+    let record = describe(conf, ttid)
+        .await?
+        .context("timeline has no durable ownership record")?;
+    if record.token != token || record.request_hash != request_hash {
+        bail!("timeline ownership token or request hash conflicts");
+    }
+    if record.tombstoned && !allow_tombstoned {
+        bail!("timeline ownership is permanently tombstoned");
+    }
+    Ok(record)
+}
+
+pub async fn tombstone(conf: &SafeKeeperConf, ttid: TenantTimelineId, token: &str) -> Result<()> {
+    let _lock = acquire_resource_lock(conf, ttid).await?;
+    let record = read(&record_path(conf, ttid))
+        .await?
+        .context("timeline has no durable ownership record")?;
+    if record.token != token {
+        bail!("timeline deletion ownership token does not match");
+    }
+    let tombstone = TimelineOwnership {
+        tombstoned: true,
+        ..record
+    };
+    let path = tombstone_path(conf, ttid);
+    if !create(&path, &tombstone).await? && read(&path).await?.as_ref() != Some(&tombstone) {
+        bail!("timeline ownership tombstone conflicts");
+    }
+    Ok(())
+}
+
