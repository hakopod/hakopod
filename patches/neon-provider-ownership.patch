+fn is_strict_ownership_route(method: &hyper::Method, path: &str) -> bool {
+    let segments = path.trim_matches('/').split('/').collect::<Vec<_>>();
+    match (method, segments.as_slice()) {
+        // This authenticated read operation uses POST because it accepts a
+        // structured inspection request. Hakopod needs it to verify the exact
+        // tenant attachment before an owned mutation or deletion.
+        (&hyper::Method::POST, ["debug", "v1", "inspect"]) => true,
+        (&hyper::Method::POST, ["v1", "tenant"]) => true,
+        (&hyper::Method::POST, ["v1", "tenant", _, "timeline"]) => true,
+        (&hyper::Method::DELETE, ["v1", "tenant", _]) => true,
+        (&hyper::Method::DELETE, ["v1", "tenant", _, "timeline", _]) => true,
+        (&hyper::Method::POST, ["control", "v1", "node"]) => true,
+        (&hyper::Method::POST, ["control", "v1", "safekeeper", _]) => true,
+        _ => false,
+    }
+}
+
+fn is_strict_upcall_route(method: &hyper::Method, path: &str) -> bool {
+    matches!(
+        (method, path),
+        (&hyper::Method::POST, "/upcall/v1/re-attach")
+            | (&hyper::Method::POST, "/upcall/v1/validate")
+            | (&hyper::Method::POST, "/upcall/v1/timeline_import_status")
+    )
+}
+
+fn ownership_route_middleware<B: hyper::body::HttpBody + Send + Sync + 'static>()
+-> Middleware<B, ApiError> {
+    Middleware::pre(move |req| async move {
+        let state = get_state(&req);
+        if !state.service.get_config().hakopod_ownership_v1
+            || req.method() == &hyper::Method::GET
+            || req.method() == &hyper::Method::HEAD
+            || is_strict_upcall_route(req.method(), req.uri().path())
+            || is_strict_ownership_route(req.method(), req.uri().path())
+        {
+            return Ok(req);
+        }
+        Err(ApiError::Forbidden(
+            "mutation route is disabled by Hakopod ownership strict mode".to_string(),
+        ))
+    })
+}
+
+async fn handle_ownership_capability(req: Request<Body>) -> Result<Response<Body>, ApiError> {
+    check_permissions(&req, Scope::Admin)?;
