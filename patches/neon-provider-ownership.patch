+    let object = value.as_object_mut().ok_or_else(|| {
+        ApiError::InternalServerError(anyhow::anyhow!("owned mutation result must be an object"))
+    })?;
+    object.insert(
+        "ownership_token".to_string(),
+        Value::String(token.simple().to_string()),
+    );
+    Ok(value)
