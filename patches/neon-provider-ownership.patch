+                let mut rows = diesel::sql_query(
+                    "SELECT ownership_token, resource_kind, external_key, request_hash, \
+                     state::text AS state, result, delete_token FROM hakopod_resource_ownership \
+                     WHERE ownership_token = $1 OR (resource_kind = $2 AND external_key = $3) \
+                     FOR UPDATE",
+                )
+                .bind::<diesel::sql_types::Uuid, _>(token)
+                .bind::<diesel::sql_types::Text, _>(&resource_kind)
+                .bind::<diesel::sql_types::Text, _>(&external_key)
+                .load::<OwnershipRow>(conn)
