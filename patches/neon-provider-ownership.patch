+async fn ownership_validate_handler(
+    mut request: Request<Body>,
+) -> Result<Response<Body>, ApiError> {
+    const MAX_TIMELINES: usize = 4096;
+    check_permission(&request, None)?;
+    let mut data = json_request::<OwnershipValidationRequest>(&mut request).await?;
+    let conf = get_conf(&request);
+    if !conf.hakopod_ownership_v1 {
+        return Err(ApiError::Forbidden(
+            "ownership validation requires Hakopod ownership strict mode".to_string(),
+        ));
+    }
+    if data.timelines.len() > MAX_TIMELINES {
+        return Err(ApiError::BadRequest(anyhow::anyhow!(
+            "ownership validation exceeds {MAX_TIMELINES} timelines"
+        )));
+    }
+    data.timelines
+        .sort_by_key(|entry| (entry.tenant_id, entry.timeline_id));
+    let mut hasher = Sha256::new();
+    hasher.update(b"hakopod-safekeeper-ownership-preflight-v1\0");
+    for entry in data.timelines {
+        let ttid = TenantTimelineId::new(entry.tenant_id, entry.timeline_id);
+        let record = crate::ownership::verify(
+            conf,
+            ttid,
+            &entry.ownership_token,
+            &entry.ownership_request_hash,
+            entry.allow_tombstoned,
+        )
+        .await
+        .map_err(|error| ApiError::Conflict(error.to_string()))?;
+        hasher.update(entry.tenant_id.to_string().as_bytes());
+        hasher.update(b"/");
+        hasher.update(entry.timeline_id.to_string().as_bytes());
+        hasher.update(b"\0");
+        hasher.update(record.token.as_bytes());
+        hasher.update(b"\0");
+        hasher.update(record.request_hash.as_bytes());
+        hasher.update(if record.tombstoned {
+            b"\0tombstoned\0".as_slice()
+        } else {
+            b"\0active\0".as_slice()
+        });
+    }
+    json_response(
+        StatusCode::OK,
+        OwnershipValidationResponse {
+            schema_version: 1,
+            digest: hex::encode(hasher.finalize()),
+        },
+    )
+}
