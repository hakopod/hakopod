+            .args([
+                "--exact",
+                "ownership::tests::lifetime_lock_subprocess_helper",
+                "--nocapture",
+            ])
+            .env("HAKOPOD_OWNERSHIP_TEST_CHILD_STATE", &paths.state)
+            .env("HAKOPOD_OWNERSHIP_TEST_CHILD_READY", &ready)
+            .env("HAKOPOD_OWNERSHIP_TEST_CHILD_RELEASE", &release)
+            .stdout(Stdio::null())
+            .stderr(Stdio::null())
+            .spawn()
+            .unwrap();
+        let ready_deadline = Instant::now() + Duration::from_secs(5);
+        while !ready.exists() && Instant::now() < ready_deadline {
+            if let Some(status) = child.try_wait().unwrap() {
+                panic!("lock holder exited before readiness: {status}");
+            }
+            thread::sleep(Duration::from_millis(10));
+        }
+        assert!(ready.exists(), "lock holder did not become ready");
+        let error = match ComputeOwnership::load(Some(paths.state.clone().into_os_string())) {
+            Ok(_) => panic!("second process acquired live compute authority"),
+            Err(error) => error,
+        };
+        assert!(
+            error
+                .to_string()
+                .contains("timed out locking compute ownership state")
+        );
+        fs::write(&release, b"release").unwrap();
+        assert!(child.wait().unwrap().success());
+        ComputeOwnership::load(Some(paths.state.clone().into_os_string())).unwrap();
+    }
+}
