+use http_utils::error::ApiError;
+use hyper::{Body, Request};
+use serde_json::Value;
+use sha2::{Digest, Sha256};
+use uuid::Uuid;
+
+pub(crate) const HEADER: &str = "Hakopod-Ownership-Token";
+pub(crate) const DELETE_HEADER: &str = "Hakopod-Deletion-Token";
+
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub(crate) struct OwnershipRequest {
+    pub token: Uuid,
+    pub request_hash: [u8; 32],
+}
+
+pub(crate) fn parse(
+    request: &Request<Body>,
+    resource_kind: &str,
+    external_key: &str,
+    mut value: Value,
+) -> Result<OwnershipRequest, ApiError> {
+    let token = token(request)?;
+    canonicalize(&mut value);
+    let encoded =
+        serde_json::to_vec(&value).map_err(|e| ApiError::InternalServerError(e.into()))?;
+    let mut hasher = Sha256::new();
+    hasher.update(resource_kind.as_bytes());
+    hasher.update([0]);
+    hasher.update(external_key.as_bytes());
+    hasher.update([0]);
+    hasher.update(encoded);
+    Ok(OwnershipRequest {
+        token,
+        request_hash: hasher.finalize().into(),
+    })
+}
+
+pub(crate) fn token(request: &Request<Body>) -> Result<Uuid, ApiError> {
+    exact_token_header(request, HEADER)
+}
+
+pub(crate) fn delete_token(request: &Request<Body>) -> Result<Uuid, ApiError> {
+    exact_token_header(request, DELETE_HEADER)
+}
+
+fn exact_token_header(request: &Request<Body>, header: &str) -> Result<Uuid, ApiError> {
+    let raw_token = request
+        .headers()
+        .get(header)
+        .and_then(|v| v.to_str().ok())
+        .ok_or_else(|| ApiError::BadRequest(anyhow::anyhow!("missing or invalid Hakopod token")))?;
+    if raw_token.len() != 32
+        || raw_token == "00000000000000000000000000000000"
+        || !raw_token
+            .bytes()
+            .all(|byte| byte.is_ascii_digit() || (b'a'..=b'f').contains(&byte))
+    {
+        return Err(ApiError::BadRequest(anyhow::anyhow!(
+            "missing or invalid Hakopod token"
+        )));
+    }
+    Uuid::parse_str(raw_token)
+        .map_err(|_| ApiError::BadRequest(anyhow::anyhow!("missing or invalid Hakopod token")))
+}
+
+fn canonicalize(value: &mut Value) {
+    match value {
+        Value::Array(values) => values.iter_mut().for_each(canonicalize),
+        Value::Object(map) => {
+            let old = std::mem::take(map);
+            for (key, mut value) in old
+                .into_iter()
+                .collect::<std::collections::BTreeMap<_, _>>()
+            {
+                canonicalize(&mut value);
+                map.insert(key, value);
+            }
+        }
+        _ => {}
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    fn request(token: &str) -> Request<Body> {
+        let mut request = Request::new(Body::empty());
+        request.headers_mut().insert(HEADER, token.parse().unwrap());
+        request
+    }
+
+    #[test]
+    fn matches_go_contract_vector_and_ignores_object_key_order() {
+        let req = request("33333333333333333333333333333333");
+        let a = parse(&req, "tenant", "key", serde_json::json!({"a": 1, "b": 2})).unwrap();
+        let b = parse(&req, "tenant", "key", serde_json::json!({"b": 2, "a": 1})).unwrap();
+        assert_eq!(a.request_hash, b.request_hash);
+        assert_eq!(
+            hex::encode(a.request_hash),
+            "296002ae586b708f973d4a7f91c53789f83888e43daacbf1e08b645061ed87e5"
+        );
+    }
+
+    #[test]
+    fn hash_binds_kind_key_and_body() {
+        let req = request("33333333333333333333333333333333");
+        let a = parse(&req, "tenant", "key", serde_json::json!({"id": 1})).unwrap();
+        let b = parse(&req, "tenant", "other", serde_json::json!({"id": 1})).unwrap();
+        let c = parse(&req, "timeline", "key", serde_json::json!({"id": 1})).unwrap();
+        let d = parse(&req, "tenant", "key", serde_json::json!({"id": 2})).unwrap();
+        assert_ne!(a.request_hash, b.request_hash);
+        assert_ne!(a.request_hash, c.request_hash);
+        assert_ne!(a.request_hash, d.request_hash);
+    }
+
+    #[test]
+    fn token_encoding_is_exact() {
+        for invalid in [
+            "00000000000000000000000000000000",
+            "33333333-3333-3333-3333-333333333333",
+            "3333333333333333333333333333333G",
+            "3333333333333333333333333333333",
+        ] {
+            let request = request(invalid);
+            assert!(parse(&request, "tenant", "key", Value::Null).is_err());
+        }
+    }
+}
