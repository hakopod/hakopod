+            .resources
+            .remote_storage
+            .upload_if_absent(Bytes::from(encoded), &path, &self.cancel)
+            .await
+        {
+            Ok(()) => Ok(fence),
+            Err(ConditionalCreateError::AlreadyExists) => {
+                let download = self
+                    .resources
+                    .remote_storage
+                    .download(&path, &DownloadOpts::default(), &self.cancel)
+                    .await
+                    .map_err(|error| DeleteTenantError::Other(error.into()))?;
+                let bytes = download
+                    .download_stream
+                    .try_fold(Vec::new(), |mut all, chunk| async move {
+                        if all.len() + chunk.len() > 4096 {
+                            return Err(std::io::Error::other("tenant delete fence exceeds limit"));
+                        }
+                        all.extend_from_slice(&chunk);
+                        Ok(all)
+                    })
+                    .await
+                    .map_err(|error| DeleteTenantError::Other(error.into()))?;
+                let existing: TenantDeleteFence = serde_json::from_slice(&bytes)
+                    .map_err(|error| DeleteTenantError::Other(error.into()))?;
+                if existing.schema_version == 1
+                    && existing.authorization_digest == authorization_digest
+                    && existing.delete_token.len() == 32
+                    && existing
+                        .delete_token
+                        .bytes()
+                        .all(|byte| byte.is_ascii_digit() || (b'a'..=b'f').contains(&byte))
