+#[derive(QueryableByName, Clone)]
+struct OwnedTenantPlacementRow {
+    #[diesel(sql_type = diesel::sql_types::Text)]
+    tenant_id: String,
+    #[diesel(sql_type = diesel::sql_types::Integer)]
+    shard_number: i32,
+    #[diesel(sql_type = diesel::sql_types::Integer)]
+    shard_count: i32,
+    #[diesel(sql_type = diesel::sql_types::Nullable<diesel::sql_types::Integer>)]
+    generation: Option<i32>,
+    #[diesel(sql_type = diesel::sql_types::Nullable<diesel::sql_types::BigInt>)]
+    generation_pageserver: Option<i64>,
+    #[diesel(sql_type = diesel::sql_types::Text)]
+    placement_policy: String,
+    #[diesel(sql_type = diesel::sql_types::Uuid)]
+    ownership_token: Uuid,
+    #[diesel(sql_type = diesel::sql_types::Text)]
+    ownership_state: String,
+}
+
+fn owned_tenant_placement_response(
+    tenant_id: TenantId,
+    mut rows: Vec<OwnedTenantPlacementRow>,
+) -> DatabaseResult<Option<JsonValue>> {
+    if rows.is_empty() {
+        return Ok(None);
+    }
+    if rows.len() != 1 {
+        return Err(DatabaseError::Cas(
+            "owned placement requires one unsharded tenant".into(),
+        ));
+    }
+    let row = rows.pop().unwrap();
+    let policy = serde_json::from_str::<PlacementPolicy>(&row.placement_policy);
+    if row.tenant_id != tenant_id.to_string()
+        || row.shard_number != 0
+        || row.shard_count != 0
+        || !matches!(policy, Ok(PlacementPolicy::Attached(_)))
+        || row.ownership_state != "completed"
+        || row.ownership_token.is_nil()
+        || row.generation.is_none_or(|value| value < 1)
+        || row.generation_pageserver.is_none_or(|value| value < 1)
+    {
+        return Err(DatabaseError::Cas(
+            "owned tenant placement is not attached and complete".into(),
+        ));
+    }
+    Ok(Some(serde_json::json!({
+        "schema_version": 1,
+        "tenant_id": row.tenant_id,
+        "node_id": row.generation_pageserver.unwrap(),
+        "generation": row.generation.unwrap(),
+        "ownership_token": row.ownership_token.simple().to_string(),
+        "ownership_state": row.ownership_state,
+    })))
+}
+
+#[test]
+fn test_owned_tenant_placement_response() {
+    let tenant = TenantId::from_str("11111111111111111111111111111111").unwrap();
+    let row = OwnedTenantPlacementRow {
+        tenant_id: tenant.to_string(),
+        shard_number: 0,
+        shard_count: 0,
+        generation: Some(8),
+        generation_pageserver: Some(2),
+        placement_policy: serde_json::to_string(&PlacementPolicy::Attached(1)).unwrap(),
+        ownership_token: Uuid::from_u128(1),
+        ownership_state: "completed".into(),
+    };
+    let observed = owned_tenant_placement_response(tenant, vec![row.clone()])
+        .unwrap()
+        .unwrap();
+    assert_eq!(observed["generation"], 8);
+    assert_eq!(observed["node_id"], 2);
+    assert_eq!(
+        observed["ownership_token"],
+        row.ownership_token.simple().to_string()
+    );
+    assert!(
+        owned_tenant_placement_response(tenant, vec![])
+            .unwrap()
+            .is_none()
+    );
+    assert!(owned_tenant_placement_response(tenant, vec![row.clone(), row.clone()]).is_err());
+    for state in ["reserved", "applying", "deleting", "tombstoned"] {
+        let mut invalid = row.clone();
+        invalid.ownership_state = state.into();
+        assert!(owned_tenant_placement_response(tenant, vec![invalid]).is_err());
+    }
+    for case in 0..8 {
+        let mut invalid = row.clone();
+        match case {
+            0 => invalid.shard_count = 1,
+            1 => invalid.shard_number = 1,
+            2 => invalid.generation = None,
+            3 => invalid.generation = Some(0),
+            4 => invalid.generation_pageserver = None,
+            5 => invalid.generation_pageserver = Some(0),
+            6 => {
+                invalid.placement_policy =
+                    serde_json::to_string(&PlacementPolicy::Detached).unwrap()
+            }
+            _ => invalid.tenant_id = "22222222222222222222222222222222".into(),
+        }
+        assert!(owned_tenant_placement_response(tenant, vec![invalid]).is_err());
+    }
+}
