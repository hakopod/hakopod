+                    "SELECT s.tenant_id, s.shard_number, s.shard_count, s.generation, \
+                     s.generation_pageserver, s.placement_policy, o.ownership_token, \
+                     o.state::text AS ownership_state FROM tenant_shards s \
+                     JOIN hakopod_resource_ownership o ON o.resource_kind = 'tenant' \
+                     AND o.external_key = s.tenant_id WHERE s.tenant_id = $1 \
+                     ORDER BY s.shard_number LIMIT 2",
+                )
+                .bind::<diesel::sql_types::Text, _>(filter_tenant_id.to_string())
+                .load::<OwnedTenantPlacementRow>(conn)
+                .await?;
+                owned_tenant_placement_response(filter_tenant_id, rows)
+            })
+        })
+        .await
+    }
