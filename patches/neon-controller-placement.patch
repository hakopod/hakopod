+async fn handle_owned_tenant_placement(req: Request<Body>) -> Result<Response<Body>, ApiError> {
+    check_permissions(&req, Scope::Admin)?;
+    let tenant_id: TenantId = parse_request_param(&req, "tenant_id")?;
+    let service = get_state(&req).service.clone();
+    if !service.get_config().hakopod_ownership_v1 {
+        return Err(ApiError::NotFound(
+            anyhow::anyhow!("owned placement is disabled").into(),
+        ));
+    }
+    match maybe_forward(req).await {
+        ForwardOutcome::Forwarded(res) => return res,
+        ForwardOutcome::NotForwarded(_req) => {}
+    };
+    // This callback read must not wait for startup or a tenant operation lock:
+    // startup and live migration may themselves be waiting for the callback.
+    let placement = tokio::time::timeout(
+        Duration::from_secs(2),
+        service.owned_tenant_placement(tenant_id),
+    )
+    .await
+    .map_err(|_| ApiError::Timeout("owned placement read timed out".into()))??
+    .ok_or_else(|| {
+        ApiError::NotFound(anyhow::anyhow!("owned tenant placement is unavailable").into())
+    })?;
+    json_response(StatusCode::OK, placement)
+}
