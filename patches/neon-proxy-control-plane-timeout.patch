+/// HTTP client for security-sensitive control-plane lookups. Unlike the
+/// general client, every request has a fixed upper bound and is not retried by
+/// middleware; callers own any retry policy at the operation boundary.
+pub fn new_control_plane_client(request_timeout: Duration) -> ClientWithMiddleware {
+    let client = reqwest::ClientBuilder::new()
+        .timeout(request_timeout)
+        .build()
+        .expect("Failed to create control plane http client with timeout");
+
+    reqwest_middleware::ClientBuilder::new(client)
+        .with(reqwest_tracing::TracingMiddleware::default())
+        .build()
+}
