@@ -64,3 +64,34 @@ func TestSensitiveSQLBoundary(t *testing.T) {
 		})
 	}
 }
+
+func TestManagedLockdownBoundary(t *testing.T) {
+	EnableManagedLockdown()
+	tests := []struct {
+		query     string
+		forbidden bool
+	}{
+		{"COPY t FROM STDIN", false},
+		{"COPY t TO STDOUT", false},
+		{"COPY t TO '/tmp/out.csv'", true},
+		{"INSTALL httpfs", true},
+		{"LOAD httpfs", true},
+		{"ATTACH '/tmp/other.duckdb' AS other", true},
+		{"CREATE USER attacker IDENTIFIED BY 'secret'", true},
+		{"CREATE DATABASE other", true},
+		{"RENAME /* bypass */ USER root TO attacker", true},
+		{"INSERT INTO mysql.user VALUES ('attacker')", true},
+		{"UPDATE `mysql`.`user` SET plugin = 'x'", true},
+		{"DELETE FROM mysql.user", true},
+		{"SET GLOBAL max_connections = 99999", true},
+		{"CREATE /* hidden */ PLUGIN attacker SONAME 'x.so'", true},
+		{"ALTER USER root IDENTIFIED BY 'secret'", true},
+		{"SELECT * FROM read_parquet('/tmp/input.parquet')", true},
+		{"SELECT 1", false},
+	}
+	for _, tt := range tests {
+		if got := IsSensitiveSQL(tt.query); got != tt.forbidden {
+			t.Errorf("IsSensitiveSQL(%q) = %t, want %t", tt.query, got, tt.forbidden)
+		}
+	}
+}
