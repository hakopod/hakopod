index 0000000..09f306f
--- /dev/null
+++ b/managed_runtime.go
@@ -0,0 +1,275 @@
+package main
+
+import (
+	"bytes"
+	"context"
+	"crypto/sha256"
+	"crypto/tls"
+	"crypto/x509"
+	"database/sql"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"net"
+	"net/url"
+	"os"
+	"path/filepath"
+	"strconv"
+	"time"
+
+	mysqlDriver "github.com/go-sql-driver/mysql"
+	"github.com/jackc/pgx/v5"
+)
+
+const managedSchemaVersion = 1
+
+type managedConfig struct {
+	SchemaVersion           int    `json:"schema_version"`
+	Database                string `json:"database"`
+	DataDir                 string `json:"data_dir"`
+	PasswordFile            string `json:"password_file"`
+	TLSCertFile             string `json:"tls_cert_file"`
+	TLSKeyFile              string `json:"tls_key_file"`
+	ServerName              string `json:"server_name"`
+	MySQLPort               int    `json:"mysql_port"`
+	PostgresPort            int    `json:"postgres_port"`
+	MemoryLimitBytes        int64  `json:"memory_limit_bytes"`
+	Threads                 int    `json:"threads"`
+	TempDirectory           string `json:"temp_directory"`
+	TempLimitBytes          int64  `json:"temp_limit_bytes"`
+	MaxConnections          uint64 `json:"max_connections"`
+	StatementTimeoutSeconds int    `json:"statement_timeout_seconds"`
+}
+
+func loadManagedConfig(path string) (managedConfig, string, tls.Certificate, error) {
+	var cfg managedConfig
+	raw, err := readBoundedFile(path, 16<<10)
+	if err != nil {
+		return cfg, "", tls.Certificate{}, fmt.Errorf("read managed config: %w", err)
+	}
+	decoder := json.NewDecoder(bytes.NewReader(raw))
+	decoder.DisallowUnknownFields()
+	if err := decoder.Decode(&cfg); err != nil {
+		return cfg, "", tls.Certificate{}, fmt.Errorf("decode managed config: %w", err)
+	}
+	if err := decoder.Decode(&struct{}{}); !errors.Is(err, io.EOF) {
+		return cfg, "", tls.Certificate{}, errors.New("managed config must contain exactly one JSON object")
+	}
+	if cfg.SchemaVersion != managedSchemaVersion || cfg.Database != "app" || cfg.DataDir != "/var/lib/myduck" ||
+		cfg.PasswordFile != "/etc/hakopod-app/password" || cfg.TLSCertFile != "/etc/hakopod-tls/tls.crt" || cfg.TLSKeyFile != "/etc/hakopod-tls/tls.key" || cfg.ServerName == "" ||
+		cfg.MySQLPort != 3306 || cfg.PostgresPort != 5432 || cfg.MemoryLimitBytes < 268435456 || cfg.Threads < 1 || cfg.Threads > 64 ||
+		cfg.TempDirectory != "/var/lib/myduck/tmp" || cfg.TempLimitBytes < 67108864 || cfg.MaxConnections < 1 || cfg.MaxConnections > 1024 ||
+		cfg.StatementTimeoutSeconds < 1 || cfg.StatementTimeoutSeconds > 3600 {
+		return cfg, "", tls.Certificate{}, errors.New("managed config violates the supported schema")
+	}
+	passwordInfo, err := os.Stat(cfg.PasswordFile)
+	if err != nil || !passwordInfo.Mode().IsRegular() || passwordInfo.Mode().Perm()&0027 != 0 {
+		return cfg, "", tls.Certificate{}, errors.New("managed password file must be a private regular file")
+	}
+	keyInfo, err := os.Stat(cfg.TLSKeyFile)
+	if err != nil || !keyInfo.Mode().IsRegular() || keyInfo.Mode().Perm()&0027 != 0 {
+		return cfg, "", tls.Certificate{}, errors.New("managed TLS key must be a private regular file")
+	}
+	passwordBytes, err := readBoundedFile(cfg.PasswordFile, 128)
+	if err != nil {
+		return cfg, "", tls.Certificate{}, fmt.Errorf("read managed password: %w", err)
+	}
+	password := string(passwordBytes)
+	decoded, err := hex.DecodeString(password)
+	if err != nil || len(decoded) != 32 || len(password) != 64 {
+		return cfg, "", tls.Certificate{}, errors.New("managed password must contain exactly 64 hexadecimal characters")
+	}
+	certPEM, err := readBoundedFile(cfg.TLSCertFile, 64<<10)
+	if err != nil {
+		return cfg, "", tls.Certificate{}, fmt.Errorf("read managed TLS certificate: %w", err)
+	}
+	keyPEM, err := readBoundedFile(cfg.TLSKeyFile, 16<<10)
+	if err != nil {
+		return cfg, "", tls.Certificate{}, fmt.Errorf("read managed TLS key: %w", err)
+	}
+	cert, err := tls.X509KeyPair(certPEM, keyPEM)
+	if err != nil {
+		return cfg, "", tls.Certificate{}, fmt.Errorf("load managed TLS identity: %w", err)
+	}
+	if len(cert.Certificate) == 0 {
+		return cfg, "", tls.Certificate{}, errors.New("managed TLS certificate chain is empty")
+	}
+	cert.Leaf, err = x509.ParseCertificate(cert.Certificate[0])
+	if err != nil {
+		return cfg, "", tls.Certificate{}, errors.New("parse managed TLS certificate")
+	}
+	now := time.Now()
+	if now.Before(cert.Leaf.NotBefore) || now.After(cert.Leaf.NotAfter) || len(cert.Leaf.DNSNames) == 0 {
+		return cfg, "", tls.Certificate{}, errors.New("managed TLS certificate is not currently valid for a DNS name")
+	}
+	if err := cert.Leaf.VerifyHostname(cfg.ServerName); err != nil {
+		return cfg, "", tls.Certificate{}, errors.New("managed TLS certificate does not match server_name")
+	}
+	return cfg, password, cert, nil
+}
+
+func managedTLSConfig(cert tls.Certificate) *tls.Config {
+	return &tls.Config{Certificates: []tls.Certificate{cert}, MinVersion: tls.VersionTLS12}
+}
+
+func applyManagedConfig(cfg managedConfig, password string) {
+	address = "0.0.0.0"
+	port = cfg.MySQLPort
+	postgresPort = cfg.PostgresPort
+	defaultDb = cfg.Database
+	dataDirectory = cfg.DataDir
+	superuserPassword = password
+	queryRowLimit = 100000
+	flightsqlPort = -1
+}
+
+func managedCheck(configPath string, requireEmpty bool) error {
+	cfg, password, cert, err := loadManagedConfig(configPath)
+	if err != nil {
+		return err
+	}
+	leafHash := sha256.Sum256(cert.Certificate[0])
+	verify := func(rawCerts [][]byte, _ [][]*x509.Certificate) error {
+		if len(rawCerts) == 0 || sha256.Sum256(rawCerts[0]) != leafHash {
+			return errors.New("server TLS identity does not match managed certificate")
+		}
+		leaf, err := x509.ParseCertificate(rawCerts[0])
+		if err != nil {
+			return errors.New("parse server TLS certificate")
+		}
+		if err := leaf.VerifyHostname(cfg.ServerName); err != nil {
+			return errors.New("server TLS certificate does not match server_name")
+		}
+		return nil
+	}
+	tlsName := "hakopod-managed-check-" + strconv.Itoa(os.Getpid())
+	if err := mysqlDriver.RegisterTLSConfig(tlsName, &tls.Config{MinVersion: tls.VersionTLS12, InsecureSkipVerify: true, VerifyPeerCertificate: verify}); err != nil {
+		return err
+	}
+	defer mysqlDriver.DeregisterTLSConfig(tlsName)
+	ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+	defer cancel()
+	mysqlClientConfig := mysqlDriver.NewConfig()
+	mysqlClientConfig.User = "root"
+	mysqlClientConfig.Passwd = password
+	mysqlClientConfig.Net = "tcp"
+	mysqlClientConfig.Addr = net.JoinHostPort("127.0.0.1", strconv.Itoa(cfg.MySQLPort))
+	mysqlClientConfig.DBName = cfg.Database
+	mysqlClientConfig.TLSConfig = tlsName
+	mysqlDB, err := sql.Open("mysql", mysqlClientConfig.FormatDSN())
+	if err != nil {
+		return err
+	}
+	defer mysqlDB.Close()
+	var mysqlOID string
+	if err := mysqlDB.QueryRowContext(ctx, "SELECT CAST(database_oid AS VARCHAR) FROM duckdb_databases() WHERE database_name = 'app'").Scan(&mysqlOID); err != nil {
+		return fmt.Errorf("mysql managed check: %w", err)
+	}
+	pgConfig, err := pgx.ParseConfig(fmt.Sprintf("postgresql://postgres:%s@127.0.0.1:%d/app", url.QueryEscape(password), cfg.PostgresPort))
+	if err != nil {
+		return err
+	}
+	pgConfig.TLSConfig = &tls.Config{MinVersion: tls.VersionTLS12, InsecureSkipVerify: true, VerifyPeerCertificate: verify}
+	pgConfig.Fallbacks = nil
+	pgConn, err := pgx.ConnectConfig(ctx, pgConfig)
+	if err != nil {
+		return fmt.Errorf("postgres managed check: %w", err)
+	}
+	defer pgConn.Close(ctx)
+	var pgOID string
+	if err := pgConn.QueryRow(ctx, "SELECT CAST(database_oid AS VARCHAR) FROM duckdb_databases() WHERE database_name = 'app'").Scan(&pgOID); err != nil {
+		return fmt.Errorf("postgres managed check: %w", err)
+	}
+	if mysqlOID == "" || mysqlOID != pgOID {
+		return errors.New("wire protocols do not expose the same managed database")
+	}
+	if requireEmpty {
+		const emptyQuery = `SELECT
+			(SELECT COUNT(*) FROM information_schema.tables WHERE table_catalog = 'app' AND table_schema NOT IN ('information_schema', 'pg_catalog', 'mysql')) +
+			(SELECT COUNT(*) FROM information_schema.schemata WHERE catalog_name = 'app' AND schema_name NOT IN ('main', 'information_schema', 'pg_catalog', 'mysql')) +
+			(SELECT COUNT(*) FROM duckdb_sequences() WHERE database_name = 'app') +
+			(SELECT COUNT(*) FROM duckdb_functions() WHERE database_name = 'app' AND internal = false) +
+			(SELECT COUNT(*) FROM duckdb_types() WHERE database_name = 'app' AND internal = false)`
+		var mysqlTables, pgTables int64
+		if err := mysqlDB.QueryRowContext(ctx, emptyQuery).Scan(&mysqlTables); err != nil {
+			return fmt.Errorf("mysql managed empty check: %w", err)
+		}
+		if err := pgConn.QueryRow(ctx, emptyQuery).Scan(&pgTables); err != nil {
+			return fmt.Errorf("postgres managed empty check: %w", err)
+		}
+		if mysqlTables != 0 || pgTables != 0 {
+			return errors.New("managed database contains user tables")
+		}
+	}
+	if err := rejectPlaintextMySQL(ctx, cfg, password); err != nil {
+		return err
+	}
+	if err := rejectPlaintextPostgres(ctx, cfg, password); err != nil {
+		return err
+	}
+	return nil
+}
+
+func readBoundedFile(path string, limit int64) ([]byte, error) {
+	f, err := os.Open(path)
+	if err != nil {
+		return nil, err
+	}
+	defer f.Close()
+	data, err := io.ReadAll(io.LimitReader(f, limit+1))
+	if err != nil {
+		return nil, err
+	}
+	if int64(len(data)) > limit {
+		return nil, errors.New("file exceeds managed size limit")
+	}
+	return data, nil
+}
+
+func rejectPlaintextMySQL(ctx context.Context, cfg managedConfig, password string) error {
+	clientConfig := mysqlDriver.NewConfig()
+	clientConfig.User, clientConfig.Passwd, clientConfig.Net = "root", password, "tcp"
+	clientConfig.Addr, clientConfig.DBName = net.JoinHostPort("127.0.0.1", strconv.Itoa(cfg.MySQLPort)), cfg.Database
+	db, err := sql.Open("mysql", clientConfig.FormatDSN())
+	if err != nil {
+		return nil
+	}
+	defer db.Close()
+	if err := db.PingContext(ctx); err == nil {
+		return errors.New("mysql accepted a plaintext connection")
+	}
+	return nil
+}
+
+func rejectPlaintextPostgres(ctx context.Context, cfg managedConfig, password string) error {
+	clientConfig, err := pgx.ParseConfig(fmt.Sprintf("postgresql://postgres:%s@127.0.0.1:%d/app?sslmode=disable", url.QueryEscape(password), cfg.PostgresPort))
+	if err != nil {
+		return err
+	}
+	conn, err := pgx.ConnectConfig(ctx, clientConfig)
+	if err == nil {
+		conn.Close(ctx)
+		return errors.New("postgres accepted a plaintext connection")
+	}
+	return nil
+}
+
+func ensureManagedDirectories(cfg managedConfig) error {
+	marker := filepath.Join(cfg.DataDir, ".hakopod-restore-pending")
+	if _, err := os.Lstat(marker); err == nil {
+		return errors.New("managed restore is incomplete")
+	} else if !os.IsNotExist(err) {
+		return fmt.Errorf("inspect managed restore marker: %w", err)
+	}
+	for _, dir := range []string{cfg.DataDir, cfg.TempDirectory} {
+		if !filepath.IsAbs(dir) {
+			return errors.New("managed directory must be absolute")
+		}
+		if err := os.MkdirAll(dir, 0700); err != nil {
+			return fmt.Errorf("prepare managed directory: %w", err)
+		}
+	}
+	return nil
+}
