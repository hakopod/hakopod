@@ -343,6 +351,46 @@ func sensitiveStatement(tokens []sqlToken) bool {
 	return containsBareRemoteURI(tokens)
 }
 
+func managedForbiddenStatement(first string, tokens []sqlToken, words []string) bool {
+	switch first {
+	case "backup", "restore", "attach", "detach", "install", "grant", "revoke", "call":
+		return true
+	case "load":
+		return true
+	case "create", "alter", "drop":
+		for _, kind := range []string{"database", "user", "account", "role", "subscription", "secret", "plugin", "extension", "function", "macro", "type"} {
+			if containsWord(words, kind) {
+				return true
+			}
+		}
+	case "rename":
+		return containsWord(words, "user") || containsWord(words, "role") || containsWord(words, "account")
+	case "insert", "update", "delete", "replace":
+		return containsWord(words, "mysql")
+	case "set":
+		return containsWord(words, "password") || containsWord(words, "global")
+	case "start", "stop", "reset", "change":
+		return containsWord(words, "replica") || containsWord(words, "replication")
+	case "copy":
+		// Client streaming remains available; server-side file paths do not.
+		for _, token := range tokens {
+			if token.string {
+				return true
+			}
+		}
+	}
+	for i, token := range tokens {
+		if token.quoted || token.string || !isFunctionCall(tokens, i) {
+			continue
+		}
+		switch tokenLower(token) {
+		case "read_csv", "read_csv_auto", "read_json", "read_json_auto", "read_ndjson", "read_parquet", "read_text", "read_blob", "glob", "parquet_scan", "csv_scan", "delta_scan", "iceberg_scan", "postgres_scan", "mysql_scan", "sqlite_scan", "load_extension":
+			return true
+		}
+	}
+	return false
+}
+
 func tokenLower(token sqlToken) string {
 	return strings.ToLower(strings.TrimSpace(token.text))
 }
