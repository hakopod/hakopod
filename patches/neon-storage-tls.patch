 #![deny(clippy::undocumented_unsafe_blocks)]
 use std::borrow::Cow;
 use std::fmt;
+use std::fs::File;
+use std::io::{BufReader, Read};
+use std::path::PathBuf;
+use std::sync::Arc;
 
 use anyhow::{Context, bail};
 use itertools::Itertools;
 use url::Host;
+use url::Url;
+
+const MAX_STORAGE_CA_BYTES: u64 = 1024 * 1024;
+const MAX_STORAGE_CA_CERTIFICATES: usize = 64;
+
+/// Parse a storage connection URI and create a connector that verifies both the
+/// configured CA and the server hostname. Storage connections never fall back
+/// to plaintext.
+pub fn storage_tls_config(
+    connection_uri: &str,
+) -> anyhow::Result<(String, tokio_postgres_rustls::MakeRustlsConnect)> {
+    let mut uri = Url::parse(connection_uri).context("invalid storage PostgreSQL URI")?;
+    let mut sslmode = None;
+    let mut root = None;
+    let mut retained = Vec::new();
+    for (key, value) in uri.query_pairs() {
+        match key.as_ref() {
+            "sslmode" => {
+                if sslmode.is_some() {
+                    bail!("storage PostgreSQL URI contains duplicate sslmode parameters");
+                }
+                sslmode = Some(value.into_owned());
+            }
+            "sslrootcert" => {
+                if root.is_some() {
+                    bail!("storage PostgreSQL URI contains duplicate sslrootcert parameters");
+                }
+                root = Some(PathBuf::from(value.into_owned()));
+            }
+            _ => retained.push((key.into_owned(), value.into_owned())),
+        }
+    }
+    if sslmode.as_deref() != Some("verify-full") {
+        bail!("storage PostgreSQL URI requires sslmode=verify-full");
+    }
+    let connector = storage_tls_connector(root)?;
+    uri.query_pairs_mut()
+        .clear()
+        .extend_pairs(retained)
+        .append_pair("sslmode", "require");
+    Ok((uri.into(), connector))
+}
+
+/// Load the storage CA used for internal provider PostgreSQL connections.
+pub fn storage_tls_connector(
+    root: Option<PathBuf>,
+) -> anyhow::Result<tokio_postgres_rustls::MakeRustlsConnect> {
+    let root = root
+        .or_else(|| std::env::var_os("NEON_STORAGE_CA_FILE").map(PathBuf::from))
+        .context("storage connection requires sslrootcert or NEON_STORAGE_CA_FILE")?;
+    let file = File::open(&root).context("open storage CA file")?;
+    let mut contents = Vec::new();
+    file.take(MAX_STORAGE_CA_BYTES + 1)
+        .read_to_end(&mut contents)
+        .context("read storage CA file")?;
+    if contents.len() as u64 > MAX_STORAGE_CA_BYTES {
+        bail!("storage CA file exceeds size limit");
+    }
+    let mut reader = BufReader::new(contents.as_slice());
+    let certificates = rustls_pemfile::certs(&mut reader)
+        .collect::<Result<Vec<_>, _>>()
+        .context("parse storage CA file")?;
+    if certificates.is_empty() {
+        bail!("storage CA file contains no certificates");
+    }
+    if certificates.len() > MAX_STORAGE_CA_CERTIFICATES {
+        bail!("storage CA file contains too many certificates");
+    }
+    let mut roots = rustls::RootCertStore::empty();
+    for certificate in certificates {
+        roots
+            .add(certificate)
+            .context("add storage CA certificate")?;
+    }
+    let tls = rustls::ClientConfig::builder_with_provider(Arc::new(
+        rustls::crypto::ring::default_provider(),
+    ))
+    .with_safe_default_protocol_versions()
+    .context("select storage TLS protocol versions")?
+    .with_root_certificates(roots)
+    .with_no_client_auth();
+    Ok(tokio_postgres_rustls::MakeRustlsConnect::new(tls))
+}
+
+#[cfg(test)]
+mod tests_storage_tls {
+    use std::fs;
+    use std::str::FromStr;
+
+    use anyhow::Context;
+
+    use super::{MAX_STORAGE_CA_BYTES, storage_tls_config, storage_tls_connector};
+
+    #[test]
+    fn strict_uri_rejects_missing_and_duplicate_tls_parameters() {
+        let missing = storage_tls_config("postgresql://storage.example/test")
+            .err()
+            .unwrap();
+        assert!(missing.to_string().contains("sslmode=verify-full"));
+
+        let duplicate_mode = storage_tls_config(
+            "postgresql://storage.example/test?sslmode=verify-full&sslmode=verify-full",
+        )
+        .err()
+        .unwrap();
+        assert!(duplicate_mode.to_string().contains("duplicate sslmode"));
+
+        let duplicate_root = storage_tls_config(
+            "postgresql://storage.example/test?sslmode=verify-full&sslrootcert=a&sslrootcert=b",
+        )
+        .err()
+        .unwrap();
+        assert!(duplicate_root.to_string().contains("duplicate sslrootcert"));
+    }
+
+    #[test]
+    fn ca_file_size_is_bounded() {
+        let path = std::env::temp_dir().join(format!(
+            "neon-storage-ca-size-{}-{}",
+            std::process::id(),
+            std::thread::current().name().unwrap_or("test")
+        ));
+        fs::write(&path, vec![b'x'; MAX_STORAGE_CA_BYTES as usize + 1]).unwrap();
+        let error = storage_tls_connector(Some(path.clone())).err().unwrap();
+        fs::remove_file(path).unwrap();
+        assert!(error.to_string().contains("exceeds size limit"));
+    }
+
+    #[tokio::test]
+    async fn live_strict_storage_tls_matrix() {
+        if std::env::var_os("HAKOPOD_STORAGE_TLS_LIVE").is_none() {
+            return;
+        }
+
+        async fn connect(name: &str) -> anyhow::Result<tokio_postgres::Client> {
+            let uri = std::env::var(name).context("missing live storage TLS test URI")?;
+            let (uri, tls) = storage_tls_config(&uri)?;
+            let config = tokio_postgres::Config::from_str(&uri)?;
+            let (client, connection) = config.connect(tls).await?;
+            tokio::spawn(async move {
+                let _ = connection.await;
+            });
+            Ok(client)
+        }
+
+        let client = connect("HAKOPOD_STORAGE_TLS_POSITIVE_URI").await.unwrap();
+        let row = client.query_one("SELECT 1", &[]).await.unwrap();
+        assert_eq!(row.get::<_, i32>(0), 1);
+        println!("trusted CA and matching hostname: connected");
+
+        for (name, outcome) in [
+            ("HAKOPOD_STORAGE_TLS_WRONG_CA_URI", "wrong CA: rejected"),
+            (
+                "HAKOPOD_STORAGE_TLS_WRONG_HOST_URI",
+                "wrong hostname: rejected",
+            ),
+            (
+                "HAKOPOD_STORAGE_TLS_PLAINTEXT_URI",
+                "plaintext endpoint: rejected",
+            ),
+        ] {
+            assert!(
+                connect(name).await.is_err(),
+                "{name} unexpectedly connected"
+            );
+            println!("{outcome}");
+        }
+    }
+}
 
