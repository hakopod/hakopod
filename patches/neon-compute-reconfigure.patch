+
+    #[test]
+    fn observed_digest_is_absent_until_configuration_is_running() {
+        let mut spec = ComputeSpec::default();
+        spec.tenant_id = Some("11111111111111111111111111111111".parse().unwrap());
+        spec.timeline_id = Some("22222222222222222222222222222222".parse().unwrap());
+        spec.pageserver_connstring = Some("postgresql://pageserver:6400".into());
+        spec.safekeeper_connstrings = vec!["safekeeper:5454".into()];
+        let mut state = ComputeState::new();
+        let authorized = crate::ownership::spec_hash(&spec).unwrap();
+        state.pspec = Some(ParsedSpec::try_from(spec).unwrap());
+        for status in [
+            ComputeStatus::Empty,
+            ComputeStatus::ConfigurationPending,
+            ComputeStatus::Init,
+            ComputeStatus::Configuration,
+            ComputeStatus::Failed,
+        ] {
+            state.status = status;
+            let response =
+                compute_status_response(&state, Some("owned".into()), Some(authorized.clone()))
+                    .unwrap();
+            assert!(response.spec_sha256.is_none());
+            assert!(response.routing_sha256.is_none());
+            assert_eq!(response.authorized_spec_sha256, Some(authorized.clone()));
+        }
+        state.status = ComputeStatus::Running;
+        let response =
+            compute_status_response(&state, Some("owned".into()), Some(authorized.clone()))
+                .unwrap();
+        assert_eq!(response.spec_sha256, Some(authorized));
+        assert!(response.routing_sha256.is_some());
     }
 }
