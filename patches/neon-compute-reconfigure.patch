+    #[test]
+    fn routing_projection_matches_go_canonical_bytes() {
+        let spec = routed_spec("unused");
+        let canonical = br#"{"pageserver_connstring":"postgresql://pageserver-0:6400?sslmode=verify-full&sslrootcert=/ca.crt","safekeeper_connstrings":["safekeeper-0:5454","safekeeper-1:5454","safekeeper-2:5454"],"safekeepers_generation":4,"tenant_id":"11111111111111111111111111111111","timeline_id":"22222222222222222222222222222222"}"#;
+        assert_eq!(
+            routing_hash(&spec).unwrap(),
+            hex::encode(Sha256::digest(canonical))
+        );
+        let mut reordered = spec.clone();
+        reordered.safekeeper_connstrings.reverse();
+        assert_eq!(
+            routing_hash(&spec).unwrap(),
+            routing_hash(&reordered).unwrap()
+        );
+    }
