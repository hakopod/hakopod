+        let paths = TestPath::new();
+        let token = Uuid::new_v4().simple().to_string();
+        let ownership = ComputeOwnership::load(Some(paths.state.clone().into_os_string())).unwrap();
+        let original = replica_spec(&token);
+        assert!(supported_routing_spec(&original));
+        ownership
+            .authorize_configure(&headers(&token), &original)
+            .unwrap();
+        let mut relocated = original.clone();
+        relocated.pageserver_connstring =
+            Some("postgresql://pageserver-1:6400?sslmode=verify-full&sslrootcert=/ca.crt".into());
+        ownership
+            .authorize_configure(&cas_headers(&token, &original), &relocated)
+            .unwrap();
+
+        let mut rejected = Vec::new();
+        let mut primary = relocated.clone();
+        primary.mode = ComputeMode::Primary;
+        rejected.push(primary);
+        let mut nonempty = relocated.clone();
+        nonempty.safekeeper_connstrings = vec!["safekeeper-0:5454".into()];
+        rejected.push(nonempty);
+        let mut disabled_tls = relocated.clone();
+        let value = unique_setting(&disabled_tls, "primary_conninfo")
+            .unwrap()
+            .to_owned();
+        setting_mut(&mut disabled_tls, "primary_conninfo").value =
+            Some(value.replace("sslmode=verify-full", "sslmode=disable"));
+        rejected.push(disabled_tls);
+        let mut password = relocated.clone();
+        setting_mut(&mut password, "primary_conninfo")
+            .value
+            .as_mut()
+            .unwrap()
+            .push_str(" password=forbidden");
+        rejected.push(password);
+        let mut foreign = relocated.clone();
+        let value = unique_setting(&foreign, "primary_conninfo")
+            .unwrap()
+            .to_owned();
+        setting_mut(&mut foreign, "primary_conninfo").value =
+            Some(value.replace("safekeeper-0", "foreign"));
+        rejected.push(foreign);
+        let mut slot = relocated.clone();
+        setting_mut(&mut slot, "primary_slot_name").value = Some("repl_other_".into());
+        rejected.push(slot);
+        for changed in rejected {
+            assert!(
+                ownership
+                    .authorize_configure(&cas_headers(&token, &relocated), &changed)
+                    .is_err()
+            );
+        }
+    }
