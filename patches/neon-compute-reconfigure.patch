+    #[test]
+    fn concurrent_routing_updates_have_only_one_cas_winner() {
+        let paths = TestPath::new();
+        let token = Uuid::new_v4().simple().to_string();
+        let ownership = std::sync::Arc::new(
+            ComputeOwnership::load(Some(paths.state.clone().into_os_string())).unwrap(),
+        );
+        let original = routed_spec(&token);
+        ownership
+            .authorize_configure(&headers(&token), &original)
+            .unwrap();
+        let barrier = std::sync::Arc::new(std::sync::Barrier::new(2));
+        let mut workers = Vec::new();
+        for generation in [5, 6] {
+            let ownership = ownership.clone();
+            let barrier = barrier.clone();
+            let mut updated = original.clone();
+            updated.safekeepers_generation = Some(generation);
+            let headers = cas_headers(&token, &original);
+            workers.push(thread::spawn(move || {
+                barrier.wait();
+                ownership.authorize_configure(&headers, &updated).is_ok()
+            }));
+        }
+        let winners = workers
+            .into_iter()
+            .map(|worker| worker.join().unwrap() as usize)
+            .sum::<usize>();
+        assert_eq!(winners, 1);
+    }
