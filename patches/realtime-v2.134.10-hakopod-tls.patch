--- a/lib/realtime/database_tls.ex
+++ b/lib/realtime/database_tls.ex
@@ -0,0 +1,18 @@
+defmodule Realtime.DatabaseTLS do
+  @moduledoc false
+
+  @tls_versions [:"tlsv1.2", :"tlsv1.3"]
+
+  @spec options(String.t(), String.t()) :: keyword()
+  def options(server_name, ca_path) when is_binary(server_name) and is_binary(ca_path) do
+    [
+      verify: :verify_peer,
+      versions: @tls_versions,
+      cacertfile: ca_path,
+      server_name_indication: to_charlist(server_name),
+      customize_hostname_check: [
+        match_fun: :public_key.pkix_verify_hostname_match_fun(:https)
+      ]
+    ]
+  end
+end
