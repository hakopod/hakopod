--- a/test/realtime/database_tls_test.exs
+++ b/test/realtime/database_tls_test.exs
@@ -0,0 +1,15 @@
+defmodule Realtime.DatabaseTLSTest do
+  use ExUnit.Case, async: true
+
+  alias Realtime.DatabaseTLS
+
+  test "requires peer and hostname verification with the supplied CA" do
+    options = DatabaseTLS.options("db", "/etc/hakopod-database-ca/ca.crt")
+
+    assert options[:verify] == :verify_peer
+    assert options[:versions] == [:"tlsv1.2", :"tlsv1.3"]
+    assert options[:cacertfile] == "/etc/hakopod-database-ca/ca.crt"
+    assert options[:server_name_indication] == ~c"db"
+    assert is_function(options[:customize_hostname_check][:match_fun], 2)
+  end
+end
