+                let row = diesel::sql_query(
+                    "SELECT ownership_token, resource_kind, external_key, request_hash, \
+                     state::text AS state, result, delete_token FROM hakopod_resource_ownership \
+                     WHERE ownership_token = $1 FOR UPDATE",
+                )
+                .bind::<diesel::sql_types::Uuid, _>(token)
+                .get_result::<OwnershipRow>(conn)
+                .await
+                .optional()?
+                .ok_or_else(|| {
+                    DatabaseError::Cas(
+                        "tenant cleanup ownership token does not identify a resource".into(),
+                    )
+                })?;
+                match tenant_cleanup_timeline_delete_decision(
+                    &row,
+                    token,
+                    &external_key,
+                    &request_hash,
+                )? {
+                    OwnershipDecision::Begin => {
+                        let updated = diesel::sql_query(
+                            "UPDATE hakopod_resource_ownership SET state = 'deleting', \
+                             updated_at = now() WHERE ownership_token = $1 \
+                             AND resource_kind = 'timeline' AND external_key = $2 \
+                             AND request_hash = $3 \
+                             AND ((state = 'completed' AND result IS NOT NULL) \
+                               OR (state = 'applying' AND result IS NULL))",
+                        )
+                        .bind::<diesel::sql_types::Uuid, _>(token)
+                        .bind::<diesel::sql_types::Text, _>(&external_key)
+                        .bind::<diesel::sql_types::Binary, _>(&request_hash)
+                        .execute(conn)
+                        .await?;
+                        if updated == 1 {
+                            Ok(OwnershipDecision::Begin)
+                        } else {
+                            Err(DatabaseError::Cas(
+                                "tenant cleanup ownership transition lost its compare-and-swap"
+                                    .into(),
+                            ))
+                        }
+                    }
+                    decision => Ok(decision),
+                }
+            })
+        })
+        .await
+    }
