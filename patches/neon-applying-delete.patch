+#[test]
+fn test_tenant_cleanup_timeline_delete_decision() {
+    let token = Uuid::from_u128(1);
+    let key = "11111111111111111111111111111111/22222222222222222222222222222222";
+    let hash = vec![7; 32];
+    let mut row = OwnershipRow {
+        ownership_token: token,
+        resource_kind: "timeline".into(),
+        external_key: key.into(),
+        request_hash: hash.clone(),
+        state: "applying".into(),
+        result: None,
+        delete_token: None,
+    };
+    assert_eq!(
+        tenant_cleanup_timeline_delete_decision(&row, token, key, &hash).unwrap(),
+        OwnershipDecision::Begin
+    );
+    row.state = "deleting".into();
+    assert_eq!(
+        tenant_cleanup_timeline_delete_decision(&row, token, key, &hash).unwrap(),
+        OwnershipDecision::Resume
+    );
+    row.state = "completed".into();
+    assert!(tenant_cleanup_timeline_delete_decision(&row, token, key, &hash).is_err());
+    row.result = Some(serde_json::json!({"created": true}));
+    assert_eq!(
+        tenant_cleanup_timeline_delete_decision(&row, token, key, &hash).unwrap(),
+        OwnershipDecision::Begin
+    );
+    assert!(tenant_cleanup_timeline_delete_decision(&row, Uuid::from_u128(2), key, &hash).is_err());
+    assert!(tenant_cleanup_timeline_delete_decision(&row, token, "other/key", &hash).is_err());
+    assert!(tenant_cleanup_timeline_delete_decision(&row, token, key, &[8; 32]).is_err());
+}
