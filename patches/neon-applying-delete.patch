+pub(crate) async fn tombstone_expected_remote_timeline_ownership(
+    remote_storage: &GenericRemoteStorage,
+    tenant_shard_id: &TenantShardId,
+    timeline_id: &TimelineId,
+    expected: &TimelineOwnershipRecord,
+    may_be_absent: bool,
+    cancel: &CancellationToken,
+) -> Result<(), ApiError> {
+    if let Some(tombstone) = read_remote_timeline_ownership_tombstone(
+        remote_storage,
+        tenant_shard_id,
+        timeline_id,
+        cancel,
+    )
+    .await
+    .map_err(ApiError::InternalServerError)?
+    {
+        if tombstone == *expected {
+            return Ok(());
+        }
+        return Err(ApiError::Conflict(
+            "timeline deletion tombstone conflicts with authorized ownership".to_string(),
+        ));
+    }
+    match read_remote_timeline_ownership(remote_storage, tenant_shard_id, timeline_id, cancel)
+        .await
+        .map_err(ApiError::InternalServerError)?
+    {
+        Some(record) if record != *expected => {
+            return Err(ApiError::Conflict(
+                "timeline deletion ownership reservation does not match".to_string(),
+            ));
+        }
+        None if !may_be_absent => {
+            return Err(ApiError::Conflict(
+                "timeline has no durable ownership record".to_string(),
+            ));
+        }
+        Some(_) => {}
+        None => {
+            // The tenant deletion fence is already durable before this helper is called.
+            // Claim the previously absent reservation key before publishing the tombstone.
+            // Its create-if-absent semantics closes the only window in which an in-flight
+            // creator could otherwise install a foreign reservation between our read and
+            // tombstone write.
+            let reservation_path =
+                remote_timeline_client::remote_timeline_ownership_reservation_path(
+                    tenant_shard_id,
+                    timeline_id,
+                );
+            let encoded = serde_json::to_vec(expected)
+                .map_err(|error| ApiError::InternalServerError(error.into()))?;
+            match remote_storage
+                .upload_if_absent(Bytes::from(encoded), &reservation_path, cancel)
+                .await
+            {
+                Ok(()) => {}
+                Err(ConditionalCreateError::AlreadyExists) => {
+                    let winner = read_remote_timeline_ownership(
+                        remote_storage,
+                        tenant_shard_id,
+                        timeline_id,
+                        cancel,
+                    )
+                    .await
+                    .map_err(ApiError::InternalServerError)?;
+                    if winner.as_ref() != Some(expected) {
+                        return Err(ApiError::Conflict(
+                            "timeline ownership changed while deletion claimed its reservation"
+                                .to_string(),
+                        ));
+                    }
+                }
+                Err(ConditionalCreateError::Other(error)) => {
+                    return Err(ApiError::InternalServerError(error));
+                }
+            }
+        }
+    }
+
+    let path = remote_timeline_client::remote_timeline_ownership_tombstone_path(
+        tenant_shard_id,
+        timeline_id,
+    );
+    let encoded = serde_json::to_vec(expected)
+        .map_err(|error| ApiError::InternalServerError(error.into()))?;
+    match remote_storage
+        .upload_if_absent(Bytes::from(encoded), &path, cancel)
+        .await
+    {
+        Ok(()) => {}
+        Err(ConditionalCreateError::AlreadyExists) => {
+            let existing = read_remote_timeline_ownership_tombstone(
+                remote_storage,
+                tenant_shard_id,
+                timeline_id,
+                cancel,
+            )
+            .await
+            .map_err(ApiError::InternalServerError)?;
+            if existing.as_ref() != Some(expected) {
+                return Err(ApiError::Conflict(
+                    "timeline deletion tombstone conflicts with authorized ownership".to_string(),
+                ));
+            }
+        }
+        Err(ConditionalCreateError::Other(error)) => {
+            return Err(ApiError::InternalServerError(error));
+        }
+    }
+
+    if let Some(record) =
+        read_remote_timeline_ownership(remote_storage, tenant_shard_id, timeline_id, cancel)
+            .await
+            .map_err(ApiError::InternalServerError)?
+    {
+        if record != *expected {
+            return Err(ApiError::Conflict(
+                "timeline ownership changed while deletion tombstone was published".to_string(),
+            ));
+        }
+    }
+    Ok(())
+}
