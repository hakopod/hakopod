+fn tenant_cleanup_timeline_delete_decision(
+    row: &OwnershipRow,
+    token: Uuid,
+    external_key: &str,
+    request_hash: &[u8],
+) -> DatabaseResult<OwnershipDecision> {
+    if row.ownership_token != token
+        || row.resource_kind != "timeline"
+        || row.external_key != external_key
+        || row.request_hash != request_hash
+    {
+        return Err(DatabaseError::Cas(
+            "tenant cleanup ownership token, kind, key, or request hash conflicts".into(),
+        ));
+    }
+    match (row.state.as_str(), row.result.is_some()) {
+        ("completed", true) | ("applying", false) => Ok(OwnershipDecision::Begin),
+        ("deleting", _) => Ok(OwnershipDecision::Resume),
+        ("tombstoned", _) => Ok(OwnershipDecision::Gone),
+        _ => Err(DatabaseError::Cas(
+            "resource is not in a tenant-cleanup deletable ownership state".into(),
+        )),
+    }
+}
