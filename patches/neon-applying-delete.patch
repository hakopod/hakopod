+    /// Delete transition used only while tenant deletion holds the exclusive tenant lock.
+    /// It admits an unfinished timeline creation, but binds every ownership field before CAS.
+    pub(crate) async fn begin_tenant_cleanup_timeline_delete(
+        &self,
+        token: Uuid,
+        external_key: &str,
+        request_hash: &[u8; 32],
+    ) -> DatabaseResult<OwnershipDecision> {
+        let external_key = external_key.to_owned();
+        let request_hash = request_hash.to_vec();
+        self.with_conn(move |conn| {
+            let external_key = external_key.clone();
+            let request_hash = request_hash.clone();
