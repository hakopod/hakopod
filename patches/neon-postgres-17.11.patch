@@ -31,6 +31,11 @@ extern char *psql_scan_slash_option(PsqlScanState state,
 
 extern void psql_scan_slash_command_end(PsqlScanState state);
 
+extern PsqlScanStateSave *psql_scan_get_lex_state(PsqlScanState state);
+
