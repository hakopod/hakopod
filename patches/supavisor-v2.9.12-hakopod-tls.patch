diff --git a/lib/supavisor/tls.ex b/lib/supavisor/tls.ex
new file mode 100644
index 0000000..6ef7f12
--- /dev/null
+++ b/lib/supavisor/tls.ex
@@ -0,0 +1,17 @@
+defmodule Supavisor.TLS do
+  @moduledoc false
+
+  @tls_versions [:"tlsv1.2", :"tlsv1.3"]
+
+  @spec peer_options(String.t() | charlist(), keyword()) :: keyword()
+  def peer_options(server_name, trust_options) when is_list(trust_options) do
+    [
+      verify: :verify_peer,
+      versions: @tls_versions,
+      server_name_indication: to_charlist(server_name),
+      customize_hostname_check: [
+        match_fun: :public_key.pkix_verify_hostname_match_fun(:https)
+      ]
+    ] ++ trust_options
+  end
+end
diff --git a/test/supavisor/tls_test.exs b/test/supavisor/tls_test.exs
new file mode 100644
index 0000000..0e30200
--- /dev/null
+++ b/test/supavisor/tls_test.exs
@@ -0,0 +1,23 @@
+defmodule Supavisor.TLSTest do
+  use ExUnit.Case, async: true
+
+  test "peer options require trusted TLS, HTTPS hostname verification, and TLS 1.2 or newer" do
+    options = Supavisor.TLS.peer_options("db", cacerts: [<<1, 2, 3>>])
+
+    assert options[:verify] == :verify_peer
+    assert options[:versions] == [:"tlsv1.2", :"tlsv1.3"]
+    assert options[:server_name_indication] == ~c"db"
+    assert options[:cacerts] == [<<1, 2, 3>>]
+
+    match_fun = options[:customize_hostname_check][:match_fun]
+    assert is_function(match_fun, 2)
+    refute match_fun.({:dns_id, ~c"other.example"}, {:dNSName, ~c"db"})
+  end
+
+  test "peer options support a CA certificate file for the metadata repository" do
+    options = Supavisor.TLS.peer_options("db", cacertfile: "/run/ca.crt")
+
+    assert options[:cacertfile] == "/run/ca.crt"
+    assert options[:server_name_indication] == ~c"db"
+  end
+end
