+func TestUserXAttrApplierRejectsNamespaceMismatchAndCancellation(t *testing.T) {
+	// Nil dependencies ensure these failures happen before mounting or applying.
+	applier := &userXAttrApplier{}
+	_, err := applier.Apply(context.Background(), ocispec.Descriptor{}, []mount.Mount{{Type: "overlay"}})
+	require.ErrorContains(t, err, "requires an overlay mount with userxattr")
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	_, err = applier.Apply(ctx, ocispec.Descriptor{}, []mount.Mount{{Type: "overlay", Options: []string{"userxattr"}}})
+	require.ErrorIs(t, err, context.Canceled)
+	ctx, cancel = context.WithCancel(context.Background())
+	applier.withTempMount = func(_ context.Context, _ []mount.Mount, fn func(string) error) error {
+		cancel()
+		return fn("/merged")
+	}
+	_, err = applier.Apply(ctx, ocispec.Descriptor{}, []mount.Mount{{Type: "overlay", Options: []string{"userxattr"}}})
+	require.ErrorIs(t, err, context.Canceled)
+}
