diff --git a/util/overlay/userxattr_linux.go b/util/overlay/userxattr_linux.go
new file mode 100644
--- /dev/null
+++ b/util/overlay/userxattr_linux.go
@@ -0,0 +1,202 @@
+//go:build linux
+
+package overlay
+
+import (
+	"context"
+	"fmt"
+	"os"
+	"path/filepath"
+	"syscall"
+	"time"
+
+	"github.com/containerd/containerd/v2/core/mount"
+	"github.com/containerd/continuity/sysx"
+	"github.com/pkg/errors"
+	"golang.org/x/sys/unix"
+)
+
+const userXAttrMarker = ".buildkit-overlay-userxattr-v1"
+const userXAttrMarkerValue = "userxattr-v1\n"
+
+// PrepareUserXAttr verifies the requested mode before a snapshot store is opened.
+// Existing unmarked stores must be replaced, never reinterpreted in another namespace.
+func PrepareUserXAttr(ctx context.Context, root string, enabled bool) error {
+	ctx, cancel := context.WithTimeout(ctx, 10*time.Second)
+	defer cancel()
+	return prepareUserXAttr(ctx, root, enabled, probeUserXAttr)
+}
+
+func prepareUserXAttr(ctx context.Context, root string, enabled bool, probe func(context.Context, string) error) error {
+	marker := filepath.Join(root, userXAttrMarker)
+	info, err := os.Lstat(marker)
+	marked := err == nil
+	if err != nil && !os.IsNotExist(err) {
+		return errors.Wrap(err, "inspect overlay namespace marker")
+	}
+	if marked {
+		if !enabled {
+			return errors.New("snapshot volume uses userxattr; use the same mode or a new builder volume")
+		}
+		if !info.Mode().IsRegular() || info.Size() != int64(len(userXAttrMarkerValue)) {
+			return errors.New("invalid overlay namespace marker; use a new builder volume")
+		}
+		value, err := os.ReadFile(marker)
+		if err != nil {
+			return errors.Wrap(err, "read overlay namespace marker")
+		}
+		if string(value) != userXAttrMarkerValue {
+			return errors.New("unknown overlay namespace marker; use a new builder volume")
+		}
+	} else if !enabled {
+		return nil
+	} else {
+		if err := os.MkdirAll(root, 0700); err != nil {
+			return err
+		}
+		entries, err := os.ReadDir(root)
+		if err != nil {
+			return err
+		}
+		if len(entries) != 0 {
+			return errors.New("cannot enable userxattr on an existing unmarked snapshot store; use a new builder volume")
+		}
+	}
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	if err := probe(ctx, root); err != nil {
+		return errors.Wrap(err, "overlay userxattr semantic probe failed")
+	}
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	if marked {
+		return nil
+	}
+	file, err := os.OpenFile(marker, os.O_WRONLY|os.O_CREATE|os.O_EXCL, 0600)
+	if err != nil {
+		return errors.Wrap(err, "create overlay namespace marker")
+	}
+	if _, err := file.WriteString(userXAttrMarkerValue); err != nil {
+		file.Close()
+		return err
+	}
+	if err := file.Sync(); err != nil {
+		file.Close()
+		return err
+	}
+	if err := file.Close(); err != nil {
+		return err
+	}
+	dir, err := os.Open(root)
+	if err != nil {
+		return err
+	}
+	defer dir.Close()
+	if err := dir.Sync(); err != nil {
+		return err
+	}
+	return ctx.Err()
+}
+
+// probeUserXAttr checks the actual snapshot filesystem, not kernel version or UID mappings.
+// Mount targets are allocated outside the probe tree by WithTempMount, so raw-tree cleanup
+// cannot walk a mount whose unmount failed.
+func probeUserXAttr(ctx context.Context, root string) (rerr error) {
+	tmp, err := os.MkdirTemp(root, ".userxattr-probe-")
+	if err != nil {
+		return err
+	}
+	defer func() {
+		if err := os.RemoveAll(tmp); err != nil && rerr == nil {
+			rerr = errors.Wrap(err, "remove overlay probe files")
+		}
+	}()
+	lower, upper, work, empty := filepath.Join(tmp, "lower"), filepath.Join(tmp, "upper"), filepath.Join(tmp, "work"), filepath.Join(tmp, "empty")
+	for _, dir := range []string{lower, upper, work, empty, filepath.Join(lower, "opaque")} {
+		if err := os.Mkdir(dir, 0700); err != nil {
+			return err
+		}
+	}
+	for _, name := range []string{"opaque/old", "deleted", "kept"} {
+		if err := os.WriteFile(filepath.Join(lower, name), []byte("lower"), 0600); err != nil {
+			return err
+		}
+	}
+	rw := []mount.Mount{{Type: "overlay", Source: "overlay", Options: []string{
+		fmt.Sprintf("lowerdir=%s,upperdir=%s,workdir=%s", lower, upper, work), "userxattr",
+	}}}
+	if err := mount.WithTempMount(ctx, rw, func(view string) error {
+		if err := ctx.Err(); err != nil {
+			return err
+		}
+		if err := os.Remove(filepath.Join(view, "deleted")); err != nil {
+			return err
+		}
+		if err := os.RemoveAll(filepath.Join(view, "opaque")); err != nil {
+			return err
+		}
+		if err := os.Mkdir(filepath.Join(view, "opaque"), 0700); err != nil {
+			return err
+		}
+		return os.WriteFile(filepath.Join(view, "opaque/new"), []byte("upper"), 0600)
+	}); err != nil {
+		return err
+	}
+	opaque, err := sysx.LGetxattr(filepath.Join(upper, "opaque"), "user.overlay.opaque")
+	if err != nil {
+		return err
+	}
+	if string(opaque) != "y" {
+		return errors.New("overlay did not write a user namespace opaque directory")
+	}
+	whiteout, err := os.Lstat(filepath.Join(upper, "deleted"))
+	if err != nil {
+		return err
+	}
+	stat, ok := whiteout.Sys().(*syscall.Stat_t)
+	if !ok || whiteout.Mode()&os.ModeCharDevice == 0 || stat.Rdev != 0 {
+		return errors.New("overlay did not create the expected whiteout device")
+	}
+	for _, name := range []string{"opaque/old", "deleted", "kept"} {
+		value, err := os.ReadFile(filepath.Join(lower, name))
+		if err != nil || string(value) != "lower" {
+			return errors.New("overlay changed its immutable lower snapshot")
+		}
+	}
+	for _, bottom := range []string{lower, empty} {
+		view := upperViewMount(upper, bottom, DiffOptions{UserXAttr: true})
+		view.Options = append(view.Options, "ro")
+		if err := mount.WithTempMount(ctx, []mount.Mount{view}, func(view string) error {
+			if err := ctx.Err(); err != nil {
+				return err
+			}
+			for _, name := range []string{"opaque/old", "deleted"} {
+				if _, err := os.Lstat(filepath.Join(view, name)); !os.IsNotExist(err) {
+					return errors.New("read-only overlay exposed a deleted lower entry")
+				}
+			}
+			value, err := os.ReadFile(filepath.Join(view, "opaque/new"))
+			if err != nil || string(value) != "upper" {
+				return errors.New("read-only overlay lost replacement directory contents")
+			}
+			if bottom == lower {
+				value, err = os.ReadFile(filepath.Join(view, "kept"))
+				if err != nil || string(value) != "lower" {
+					return errors.New("read-only overlay lost an unchanged lower file")
+				}
+			}
+			// Reading the merged view must not expose the selected overlay metadata.
+			if _, err := sysx.LGetxattr(filepath.Join(view, "opaque"), "user.overlay.opaque"); err == nil {
+				return errors.New("overlay exposed its internal opaque attribute")
+			} else if !errors.Is(err, unix.ENODATA) && !errors.Is(err, unix.EOPNOTSUPP) {
+				return err
+			}
+			return nil
+		}); err != nil {
+			return err
+		}
+	}
+	return nil
+}
