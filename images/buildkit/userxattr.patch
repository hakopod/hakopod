+	expected := ocispec.Descriptor{MediaType: ocispec.MediaTypeImageLayer, Digest: digest.FromString("uncompressed")}
+	mounts := []mount.Mount{{Type: "overlay", Source: "overlay", Options: []string{"lowerdir=/lower", "upperdir=/upper", "workdir=/work", "userxattr"}}}
+	mounted := false
+	applyCalls, optionCalls := 0, 0
+	option := func(gotCtx context.Context, gotDesc ocispec.Descriptor, cfg *diff.ApplyConfig) error {
+		require.Equal(t, ctx, gotCtx)
+		require.Equal(t, desc, gotDesc)
+		optionCalls++
+		cfg.SyncFs = true
+		return nil
+	}
+	applier := &userXAttrApplier{
+		applier: userXAttrApplyFunc(func(gotCtx context.Context, gotDesc ocispec.Descriptor, gotMounts []mount.Mount, opts ...diff.ApplyOpt) (ocispec.Descriptor, error) {
+			require.True(t, mounted)
+			require.Equal(t, ctx, gotCtx)
+			require.Equal(t, desc, gotDesc)
+			require.Equal(t, []mount.Mount{{Type: "bind", Source: "/merged", Options: []string{"rbind", "rw"}}}, gotMounts)
+			require.Len(t, opts, 1)
+			var cfg diff.ApplyConfig
+			require.NoError(t, opts[0](gotCtx, gotDesc, &cfg))
+			require.True(t, cfg.SyncFs)
+			applyCalls++
+			return expected, nil
+		}),
+		withTempMount: func(gotCtx context.Context, gotMounts []mount.Mount, fn func(string) error) error {
+			require.Equal(t, ctx, gotCtx)
+			require.Equal(t, mounts, gotMounts)
+			mounted = true
+			defer func() { mounted = false }()
+			return fn("/merged")
+		},
+	}
+	got, err := applier.Apply(ctx, desc, mounts, option)
+	require.NoError(t, err)
+	require.Equal(t, expected, got)
+	require.Equal(t, 1, applyCalls)
+	require.Equal(t, 1, optionCalls)
