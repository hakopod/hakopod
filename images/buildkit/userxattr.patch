+func (f userXAttrApplyFunc) Apply(ctx context.Context, desc ocispec.Descriptor, mounts []mount.Mount, opts ...diff.ApplyOpt) (ocispec.Descriptor, error) {
+	return f(ctx, desc, mounts, opts...)
