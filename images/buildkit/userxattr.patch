+			calls := 0
+			applier := &userXAttrApplier{
+				applier: userXAttrApplyFunc(func(context.Context, ocispec.Descriptor, []mount.Mount, ...diff.ApplyOpt) (ocispec.Descriptor, error) {
+					calls++
+					if phase == "apply" {
+						return ocispec.Descriptor{}, unix.EIO
+					}
+					return desc, nil
+				}),
+				withTempMount: func(_ context.Context, _ []mount.Mount, fn func(string) error) error {
+					if phase == "mount" {
+						return unix.EIO
+					}
+					if err := fn("/merged"); err != nil {
+						return err
+					}
+					return unix.EIO
+				},
+			}
+			_, err := applier.Apply(context.Background(), desc, []mount.Mount{{Type: "overlay", Options: []string{"userxattr"}}})
+			require.ErrorIs(t, err, unix.EIO)
+			if phase == "mount" {
+				require.Zero(t, calls)
+			} else {
+				require.Equal(t, 1, calls)
+			}
+		})
+	}
+}
