@@ -0,0 +1,51 @@
+//go:build linux
+
+package overlay
+
+import (
+	"context"
+	"fmt"
+	"slices"
+
+	"github.com/containerd/containerd/v2/core/diff"
+	"github.com/containerd/containerd/v2/core/mount"
+	ocispec "github.com/opencontainers/image-spec/specs-go/v1"
+)
+
+// NewUserXAttrApplier applies layers through the selected overlay mount so that
+// whiteouts use its metadata namespace. The upstream raw-upper shortcut writes
+// trusted.overlay.opaque and must not be used for an explicit userxattr worker.
+func NewUserXAttrApplier(applier diff.Applier) diff.Applier {
+	return &userXAttrApplier{applier: applier, withTempMount: mount.WithTempMount}
+}
+
+type userXAttrApplier struct {
+	applier       diff.Applier
+	withTempMount func(context.Context, []mount.Mount, func(string) error) error
+}
+
+func (a *userXAttrApplier) Apply(ctx context.Context, desc ocispec.Descriptor, mounts []mount.Mount, opts ...diff.ApplyOpt) (ocispec.Descriptor, error) {
+	if err := ctx.Err(); err != nil {
+		return ocispec.Descriptor{}, err
+	}
+	if len(mounts) != 1 || mounts[0].Type != "overlay" {
+		return a.applier.Apply(ctx, desc, mounts, opts...)
+	}
+	if !slices.Contains(mounts[0].Options, "userxattr") {
+		return ocispec.Descriptor{}, fmt.Errorf("userxattr layer import requires an overlay mount with userxattr")
+	}
+	var applied ocispec.Descriptor
+	err := a.withTempMount(ctx, mounts, func(root string) error {
+		if err := ctx.Err(); err != nil {
+			return err
+		}
+		var err error
+		// A bind of the merged view avoids the upstream overlay shortcut while
+		// preserving its processors, progress, checksum and syncfs handling.
+		applied, err = a.applier.Apply(ctx, desc, []mount.Mount{{
+			Type: "bind", Source: root, Options: []string{"rbind", "rw"},
+		}}, opts...)
+		return err
+	})
+	return applied, err
+}
