new file mode 100644
--- /dev/null
+++ b/cmd/buildkitd/main_oci_userxattr_test.go
@@ -0,0 +1,73 @@
+//go:build linux
+
+package main
+
+import (
+	"context"
+	"os"
+	"testing"
+
+	"github.com/moby/buildkit/cmd/buildkitd/config"
+	"github.com/stretchr/testify/require"
+	"github.com/urfave/cli/v3"
+)
+
+func TestManagedUserXAttrFlagIsExplicit(t *testing.T) {
+	t.Setenv("HAKOPOD_BUILDKIT_USERXATTR", "")
+	cfg := config.Config{}
+	require.NoError(t, runManagedUserXAttrFlags(nil, &cfg))
+	require.False(t, cfg.Workers.OCI.OverlayFSUserXAttr)
+	t.Setenv("HAKOPOD_BUILDKIT_USERXATTR", "true")
+	require.NoError(t, runManagedUserXAttrFlags(nil, &cfg))
+	require.True(t, cfg.Workers.OCI.OverlayFSUserXAttr)
+	require.NoError(t, runManagedUserXAttrFlags([]string{"--oci-worker-overlayfs-userxattr=false"}, &cfg))
+	require.False(t, cfg.Workers.OCI.OverlayFSUserXAttr)
+	t.Setenv("HAKOPOD_BUILDKIT_USERXATTR", "invalid")
+	require.Error(t, runManagedUserXAttrFlags(nil, &cfg))
+}
+
+func runManagedUserXAttrFlags(args []string, cfg *config.Config) error {
+	cmd := &cli.Command{
+		Name:  "buildkitd",
+		Flags: []cli.Flag{managedOverlayUserXAttrFlag(false)},
+		Action: func(_ context.Context, cmd *cli.Command) error {
+			return applyOCIFlags(cmd, cfg)
+		},
+	}
+	return cmd.Run(context.Background(), append([]string{"buildkitd"}, args...))
+}
+
+func TestManagedUserXAttrRejectsOtherSnapshotters(t *testing.T) {
+	for _, name := range []string{"native", "fuse-overlayfs", "stargz"} {
+		_, err := snapshotterFactory(t.TempDir(), config.OCIConfig{Snapshotter: name, OverlayFSUserXAttr: true}, nil, nil)
+		require.ErrorContains(t, err, "requires the overlayfs snapshotter")
+	}
+	_, err := snapshotterFactory(t.TempDir(), config.OCIConfig{Snapshotter: "overlayfs", ProxySnapshotterPath: "/missing", OverlayFSUserXAttr: true}, nil, nil)
+	require.ErrorContains(t, err, "proxy snapshotters")
+}
+
+func TestManagedSnapshotterPropagatesUserXAttrToReadOnlyMounts(t *testing.T) {
+	if os.Getenv("HAKOPOD_BUILDKIT_TEST_OVERLAY") != "1" {
+		t.Skip("requires an explicitly selected managed overlay test sandbox")
+	}
+	root := t.TempDir()
+	factory, err := snapshotterFactory(root, config.OCIConfig{Snapshotter: "overlayfs", OverlayFSUserXAttr: true}, nil, nil)
+	require.NoError(t, err)
+	sn, err := factory.New(root)
+	require.NoError(t, err)
+	t.Cleanup(func() { require.NoError(t, sn.Close()) })
+	ctx := context.Background()
+	_, err = sn.Prepare(ctx, "base", "")
+	require.NoError(t, err)
+	require.NoError(t, sn.Commit(ctx, "base-committed", "base"))
+	active, err := sn.Prepare(ctx, "child", "base-committed")
+	require.NoError(t, err)
+	require.Len(t, active, 1)
+	require.Contains(t, active[0].Options, "userxattr")
+	require.NoError(t, sn.Commit(ctx, "child-committed", "child"))
+	view, err := sn.View(ctx, "read-only", "child-committed")
+	require.NoError(t, err)
+	require.Len(t, view, 1)
+	require.Equal(t, "overlay", view[0].Type)
+	require.Contains(t, view[0].Options, "userxattr")
+}
