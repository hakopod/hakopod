+func TestManagedUserXAttrLayerImport(t *testing.T) {
+	if os.Getenv("HAKOPOD_BUILDKIT_TEST_OVERLAY") != "1" {
+		t.Skip("requires an explicitly selected managed overlay test sandbox")
+	}
+	for _, compressed := range []bool{false, true} {
+		t.Run(fmt.Sprintf("gzip=%t", compressed), func(t *testing.T) {
+			ctx, cancel := context.WithTimeout(context.Background(), 30*time.Second)
+			defer cancel()
+			root := t.TempDir()
+			snapshotRoot := filepath.Join(root, "snapshots")
+			require.NoError(t, PrepareUserXAttr(ctx, snapshotRoot, true))
+			sn, err := snapoverlay.NewSnapshotter(snapshotRoot, snapoverlay.WithMountOptions([]string{"userxattr"}))
+			require.NoError(t, err)
+			t.Cleanup(func() { require.NoError(t, sn.Close()) })
+			store, err := local.NewStore(filepath.Join(root, "content"))
+			require.NoError(t, err)
+			applier := NewUserXAttrApplier(winlayers.NewFileSystemApplierWithWindows(store, apply.NewFileSystemApplier(store)))
+			applyLayer := func(ref string, mounts []mount.Mount, entries []userXAttrTarEntry) {
+				uncompressed := userXAttrLayerTar(t, entries)
+				blob := uncompressed
+				mediaType := ocispec.MediaTypeImageLayer
+				if compressed {
+					var buf bytes.Buffer
+					gz := gzip.NewWriter(&buf)
+					_, err := gz.Write(uncompressed)
+					require.NoError(t, err)
+					require.NoError(t, gz.Close())
+					blob, mediaType = buf.Bytes(), ocispec.MediaTypeImageLayerGzip
+				}
+				desc := ocispec.Descriptor{MediaType: mediaType, Digest: digest.FromBytes(blob), Size: int64(len(blob))}
+				require.NoError(t, content.WriteBlob(ctx, store, ref, bytes.NewReader(blob), desc))
+				var progress int64
+				got, err := applier.Apply(ctx, desc, mounts, diff.WithSyncFs(true), diff.WithProgress(func(d ocispec.Descriptor, n int64) {
+					require.Equal(t, desc, d)
+					progress = n
+				}))
+				require.NoError(t, err)
+				require.Equal(t, digest.FromBytes(uncompressed), got.Digest)
+				require.Equal(t, int64(len(uncompressed)), got.Size)
+				require.Equal(t, ocispec.MediaTypeImageLayer, got.MediaType)
+				require.Equal(t, int64(len(blob)), progress)
+			}
+			base, err := sn.Prepare(ctx, "base-active", "")
+			require.NoError(t, err)
+			applyLayer("base", base, []userXAttrTarEntry{
+				{"opaque/", ""}, {"opaque/old-one", "old one"}, {"opaque/old-two", "old two"},
+				{"deleted", "delete me"}, {"kept", "unchanged"},
+			})
+			require.NoError(t, sn.Commit(ctx, "base", "base-active"))
+			child, err := sn.Prepare(ctx, "child-active", "base")
+			require.NoError(t, err)
+			require.Len(t, child, 1)
+			require.Equal(t, "overlay", child[0].Type)
+			require.Contains(t, child[0].Options, "userxattr")
+			applyLayer("child", child, []userXAttrTarEntry{
+				{"opaque/", ""}, {"opaque/new-before", "keep before marker"},
+				{"opaque/.wh..wh..opq", ""}, {"opaque/new-after", "keep after marker"}, {".wh.deleted", ""},
+			})
+			require.NoError(t, sn.Commit(ctx, "child", "child-active"))
+			for name, expected := range map[string]map[string]string{
+				"base":  {"opaque/old-one": "old one", "opaque/old-two": "old two", "deleted": "delete me", "kept": "unchanged"},
+				"child": {"opaque/new-before": "keep before marker", "opaque/new-after": "keep after marker", "kept": "unchanged"},
+			} {
+				view, err := sn.View(ctx, "view-"+name, name)
+				require.NoError(t, err)
+				require.NoError(t, mount.WithTempMount(ctx, view, func(root string) error {
+					actual := map[string]string{}
+					err := filepath.Walk(root, func(path string, info os.FileInfo, err error) error {
+						if err != nil || info.IsDir() {
+							return err
+						}
+						require.True(t, info.Mode().IsRegular(), "unexpected entry: %s", path)
+						rel, err := filepath.Rel(root, path)
+						if err != nil {
+							return err
+						}
+						value, err := os.ReadFile(path)
+						actual[rel] = string(value)
+						return err
+					})
+					require.NoError(t, err)
+					require.Equal(t, expected, actual)
+					return nil
+				}))
+			}
+		})
+	}
+}
+
+type userXAttrTarEntry struct {
+	name string
+	body string
+}
+
+func userXAttrLayerTar(t *testing.T, entries []userXAttrTarEntry) []byte {
+	t.Helper()
+	var buf bytes.Buffer
+	tw := tar.NewWriter(&buf)
+	for _, entry := range entries {
+		hdr := &tar.Header{Name: entry.name, Mode: 0644, Size: int64(len(entry.body)), Typeflag: tar.TypeReg}
+		if entry.name[len(entry.name)-1] == '/' {
+			hdr.Typeflag, hdr.Mode = tar.TypeDir, 0755
+		}
+		require.NoError(t, tw.WriteHeader(hdr))
+		_, err := tw.Write([]byte(entry.body))
+		require.NoError(t, err)
+	}
+	require.NoError(t, tw.Close())
+	return buf.Bytes()
+}
