+func TestOverlayFlagNamespaceAndErrors(t *testing.T) {
+	for _, name := range []string{"opaque", "redirect"} {
+		t.Run(name, func(t *testing.T) {
+			var keys []string
+			present, err := hasOverlayFlag("/fixture", name, DiffOptions{UserXAttr: true}, func(path, key string) ([]byte, error) {
+				require.Equal(t, "/fixture", path)
+				keys = append(keys, key)
+				return []byte("y"), nil
+			})
+			require.NoError(t, err)
+			require.True(t, present)
+			require.Equal(t, []string{"user.overlay." + name}, keys)
+			for _, failure := range []error{unix.EOPNOTSUPP, unix.EPERM, unix.EACCES, unix.EIO, unix.ENOENT} {
+				present, err = hasOverlayFlag("/fixture", name, DiffOptions{UserXAttr: true}, func(_, _ string) ([]byte, error) {
+					return nil, failure
+				})
+				require.False(t, present)
+				require.ErrorIs(t, err, failure)
+			}
+			present, err = hasOverlayFlag("/fixture", name, DiffOptions{UserXAttr: true}, func(_, _ string) ([]byte, error) {
+				return nil, unix.ENODATA
+			})
+			require.NoError(t, err)
+			require.False(t, present)
+		})
+	}
+}
+
+func TestLegacyOverlayFlagBehaviorIsUnchanged(t *testing.T) {
+	var keys []string
+	present, err := hasOverlayFlag("/fixture", "opaque", DiffOptions{}, func(_, key string) ([]byte, error) {
+		keys = append(keys, key)
+		if key == "trusted.overlay.opaque" {
+			return nil, unix.ENODATA
+		}
+		return []byte("y"), nil
+	})
+	require.NoError(t, err)
+	require.True(t, present)
+	require.Equal(t, []string{"trusted.overlay.opaque", "user.overlay.opaque"}, keys)
+	for _, name := range []string{"opaque", "redirect"} {
+		keys = nil
+		present, err = hasOverlayFlag("/fixture", name, DiffOptions{}, func(_, key string) ([]byte, error) {
+			keys = append(keys, key)
+			return nil, unix.EOPNOTSUPP
+		})
+		require.False(t, present)
+		require.ErrorIs(t, err, unix.EOPNOTSUPP)
+		require.Equal(t, []string{"trusted.overlay." + name}, keys)
+	}
+}
+
+func TestUpperViewPropagatesExplicitUserXAttr(t *testing.T) {
+	legacy := upperViewMount("/upper", "/empty", DiffOptions{})
+	require.Equal(t, []string{"lowerdir=/upper:/empty"}, legacy.Options)
+	managed := upperViewMount("/upper", "/empty", DiffOptions{UserXAttr: true})
+	require.Equal(t, []string{"lowerdir=/upper:/empty", "userxattr"}, managed.Options)
+}
+
+func TestUserXAttrVolumeModeIsImmutable(t *testing.T) {
+	root := t.TempDir()
+	calls := 0
+	probe := func(context.Context, string) error {
+		calls++
+		return nil
+	}
+	require.NoError(t, prepareUserXAttr(context.Background(), root, false, probe))
+	require.Zero(t, calls)
+	require.NoError(t, prepareUserXAttr(context.Background(), root, true, probe))
+	require.Equal(t, 1, calls)
+	value, err := os.ReadFile(filepath.Join(root, userXAttrMarker))
+	require.NoError(t, err)
+	require.Equal(t, userXAttrMarkerValue, string(value))
+	require.NoError(t, os.WriteFile(filepath.Join(root, "metadata.db"), []byte("existing state"), 0600))
+	require.NoError(t, prepareUserXAttr(context.Background(), root, true, probe))
+	require.Equal(t, 2, calls)
+	require.ErrorContains(t, prepareUserXAttr(context.Background(), root, false, probe), "same mode")
+	require.Equal(t, 2, calls)
+	value, err = os.ReadFile(filepath.Join(root, "metadata.db"))
+	require.NoError(t, err)
+	require.Equal(t, "existing state", string(value))
+}
+
+func TestUserXAttrRefusesUnmarkedOrInvalidState(t *testing.T) {
+	for _, state := range []string{"existing", "invalid", "symlink"} {
+		t.Run(state, func(t *testing.T) {
+			root := t.TempDir()
+			marker := filepath.Join(root, userXAttrMarker)
+			switch state {
+			case "existing":
+				require.NoError(t, os.WriteFile(filepath.Join(root, "metadata.db"), []byte("state"), 0600))
+			case "invalid":
+				require.NoError(t, os.WriteFile(marker, []byte("other-mode\n"), 0600))
+			case "symlink":
+				require.NoError(t, os.Symlink("missing", marker))
+			}
+			called := false
+			err := prepareUserXAttr(context.Background(), root, true, func(context.Context, string) error {
+				called = true
+				return nil
+			})
+			require.Error(t, err)
+			require.False(t, called)
+		})
+	}
+}
+
+func TestUserXAttrProbeFailureAndCancellationDoNotMarkVolume(t *testing.T) {
+	root := t.TempDir()
+	err := prepareUserXAttr(context.Background(), root, true, func(context.Context, string) error { return unix.EOPNOTSUPP })
+	require.ErrorIs(t, err, unix.EOPNOTSUPP)
+	_, err = os.Stat(filepath.Join(root, userXAttrMarker))
+	require.True(t, os.IsNotExist(err))
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	called := false
+	err = prepareUserXAttr(ctx, root, true, func(context.Context, string) error {
