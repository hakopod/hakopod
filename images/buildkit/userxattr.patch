@@ -0,0 +1,34 @@
+package snapshot
+
+import (
+	"context"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+type namedUserXAttrSnapshotter struct {
+	Snapshotter
+	name string
+}
+
+func (s namedUserXAttrSnapshotter) Name() string { return s.name }
+
+func TestMergeRoutesExplicitUserXAttrWithoutUserNamespaceDetection(t *testing.T) {
+	// Embedded nil operations make an unexpected capability probe fail this test.
+	sn := namedUserXAttrSnapshotter{name: "overlayfs"}
+	merged := NewMergeSnapshotter(context.Background(), sn, nil, MergeSnapshotterOpt{UserXAttr: true}).(*mergeSnapshotter)
+	require.True(t, merged.userxattr)
+	require.True(t, merged.overlayUserXAttr)
+	require.True(t, merged.tryCrossSnapshotLink)
+	require.True(t, merged.skipBaseLayers)
+}
+
+func TestMergeDoesNotApplyOverlayModeToOtherSnapshotters(t *testing.T) {
+	sn := namedUserXAttrSnapshotter{name: "native"}
+	merged := NewMergeSnapshotter(context.Background(), sn, nil, MergeSnapshotterOpt{UserXAttr: true}).(*mergeSnapshotter)
+	require.False(t, merged.userxattr)
+	require.False(t, merged.overlayUserXAttr)
+	require.True(t, merged.tryCrossSnapshotLink)
+	require.False(t, merged.skipBaseLayers)
+}
